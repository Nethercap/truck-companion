index 0000000..8978173
--- /dev/null
+++ b/packages/clis/truckdash-builder/unir.ts
@@ -0,0 +1,63 @@
+// El taller (build_variant.py) junta las calles antes de tippecanoe con esto:
+// lee el GeoJSON del generator y escribe otro con las calles que se tocan
+// punta con punta unidas (unir-calles.ts). tiles.ts lo hace solo.
+//
+// El generator escribe un feature por linea (writeGeojsonFile) porque entero
+// no entra en un string de node (ETS2 con ProMods pasa de 1 GB): se lee y se
+// escribe igual, de a una linea.
+//
+// Uso: npx tsx packages/clis/truckdash-builder/unir.ts <entrada.geojson> <salida.geojson>
+
+import fs from 'fs';
+import readline from 'readline';
+import { ATRIBUTOS, unirCalles, type Feature } from './unir-calles';
+
+async function leer(entrada: string): Promise<Feature[]> {
+  const features: Feature[] = [];
+  const lineas = readline.createInterface({
+    input: fs.createReadStream(entrada, 'utf8'),
+    crlfDelay: Infinity,
+  });
+  for await (const cruda of lineas) {
+    const linea = cruda.trim().replace(/,$/, '');
+    if (linea.length < 2 || linea[0] !== '{' || linea.at(-1) !== '}') continue;
+    const obj = JSON.parse(linea) as {
+      type?: string;
+      features?: Feature[];
+    };
+    if (obj.type === 'Feature') features.push(obj as unknown as Feature);
+    else if (obj.type === 'FeatureCollection' && obj.features)
+      for (const f of obj.features) features.push(f); // un archivo de una sola linea
+  }
+  return features;
+}
+
+function escribir(salida: string, features: Feature[]) {
+  const fd = fs.openSync(salida, 'w');
+  fs.writeSync(fd, '{\n"type": "FeatureCollection",\n"features":[\n');
+  features.forEach((f, i) => {
+    fs.writeSync(
+      fd,
+      JSON.stringify(f) + (i < features.length - 1 ? ',\n' : '\n'),
+    );
+  });
+  fs.writeSync(fd, ']\n}\n');
+  fs.closeSync(fd);
+}
+
+async function main() {
+  const [entrada, salida] = process.argv.slice(2);
+  if (!entrada || !salida) {
+    console.error('Uso: unir.ts <entrada.geojson> <salida.geojson>');
+    process.exit(1);
+  }
+  const t0 = Date.now();
+  const todo = await leer(entrada);
+  const { features, uniones } = unirCalles(todo, ATRIBUTOS);
+  escribir(salida, features);
+  console.log(
+    `${todo.length} -> ${features.length} features, ${uniones} uniones, ${((Date.now() - t0) / 1000).toFixed(1)} s`,
+  );
+}
+
+void main();
