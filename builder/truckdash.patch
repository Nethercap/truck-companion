+// La textura de un icono .mat, como la busca el juego: relativa a la carpeta
+// del .mat, o desde la raiz del juego si empieza con "/". Mapa BR Brasil 6.2
+// escribe asi las de sus 77 empresas ("/material/ui/company/small/bnr.tobj"),
+// y pegada a la carpeta quedaba "material/ui/company/small//material/...", que
+// no existe: sin icono la empresa no cuenta (icons.has(token)) y se caia del
+// mapa con "unknown company token" (Discord 14-11, 75 empresas, entre ellas
+// todas las de destino de sus trabajos).
+
+import path from 'node:path';
+
+export function rutaDeTextura(dir: string, source: string): string {
+  const ruta = source.startsWith('/') ? source : `${dir}/${source}`;
+  return path.posix.normalize(ruta).replace(/^\/+/, '');
+}
+
+// La textura de un material "ui" de los viejos (`material : "ui" { texture: ... }`).
+// Un .mat puede escribirla como lista (`texture[]: "x.tobj"`): el escudo de ruta
+// road_rtc_kazflag.mat de los mods RTC lo hace, y con el texto solo se cortaba
+// todo el armado en "parsing icon .mat files" (build.log del 16-11, 185 mods). Un icono
+// de la interfaz lleva una textura: va la primera.
+export function texturaDelMaterial(texture: string | string[]): string {
+  return Array.isArray(texture) ? texture[0] : texture;
+}
