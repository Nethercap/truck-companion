--- /dev/null
+++ b/packages/clis/parser/game-files/tests/scs-archive-v2.test.ts
@@ -0,0 +1,354 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import zlib from 'zlib';
+import { city64 } from '../cityhash';
+import { vi } from 'vitest';
+import { logger } from '../../logger';
+import {
+  directoryListingV1,
+  directoryListingV2,
+  ScsArchive,
+} from '../scs-archive';
+
+// Tipos de metadatos de HashFS v2 (MetadataType en scs-archive.ts).
+const PLAIN = 0x80;
+const DIRECTORY = 0x81;
+// Compresion de PlainMeta: los 4 bits altos del tamano comprimido.
+const NONE = 0;
+const ZLIB = 1;
+const ZLIB_HEADERLESS = 2;
+const ZSTD = 4;
+
+interface Entrada {
+  // la ruta, o el hash ya hecho (una basura no tiene ruta)
+  ruta: string | bigint;
+  directorio: boolean;
+  tipo: number;
+  compresion: number;
+  // los datos a escribir, o el indice de otra entrada cuyo offset se repite
+  datos: Buffer | number;
+  tamano: number;
+  // Trucos de empaquetador: la marca de directorio de la entrada, si no es la de
+  // `directorio`; lo que dice el encabezado de donde esta su PlainMeta, si no es
+  // justo despues (0xffffff: fuera de la tabla); y un segundo metadato de este tipo.
+  marca?: boolean;
+  indice?: number;
+  extra?: number;
+}
+
+// El listado de v2: cuantos nombres, el largo de cada uno y los nombres, los
+// subdirectorios con "/" adelante.
+function listado(nombres: string[]): Buffer {
+  const textos = nombres.map(n => Buffer.from(n, 'utf8'));
+  const cabeza = Buffer.alloc(4 + textos.length);
+  cabeza.writeUInt32LE(textos.length, 0);
+  textos.forEach((t, i) => (cabeza[4 + i] = t.length));
+  return Buffer.concat([cabeza, ...textos]);
+}
+
+// Un HashFS v2 como lo lee ScsArchive: cabecera de 53 bytes, los datos
+// alineados a 16, la tabla de entradas (16 bytes por entrada) y la de
+// metadatos (por entrada, sus encabezados de 4 bytes y un PlainMeta de 16), las
+// dos con zlib o, en un mod empaquetado sin compresion, tal cual.
+function hashfsV2(
+  entradas: Entrada[],
+  { salt = 0, comprimirTablas = true } = {},
+): string {
+  const partes: Buffer[] = [Buffer.alloc(64)];
+  let offset = 64;
+  const offsets: number[] = [];
+  for (const e of entradas) {
+    if (typeof e.datos === 'number') {
+      offsets.push(offsets[e.datos]);
+      continue;
+    }
+    offsets.push(offset);
+    const relleno = (16 - (e.datos.length % 16)) % 16;
+    partes.push(e.datos, Buffer.alloc(relleno));
+    offset += e.datos.length + relleno;
+  }
+
+  const tabla = Buffer.alloc(entradas.length * 16);
+  const bloques: Buffer[] = [];
+  let indice = 0; // en valores de 4 bytes
+  entradas.forEach((e, i) => {
+    const hash =
+      typeof e.ruta === 'bigint'
+        ? e.ruta
+        : city64(salt ? `${salt}${e.ruta}` : e.ruta);
+    const datos = typeof e.datos === 'number' ? entradas[e.datos].datos : e.datos;
+    const comprimido = (datos as Buffer).length;
+    const cantidad = e.extra === undefined ? 1 : 2;
+    tabla.writeBigUInt64LE(hash, i * 16);
+    tabla.writeUInt32LE(indice, i * 16 + 8); // indice de metadatos (de a 4 bytes)
+    tabla.writeUInt16LE(cantidad, i * 16 + 12);
+    tabla[i * 16 + 14] = (e.marca ?? e.directorio) ? 1 : 0;
+    // los encabezados (indice de sus datos y tipo), el PlainMeta justo despues y
+    // los 8 bytes del metadato de mas
+    const m = Buffer.alloc(4 * cantidad + 16 + (cantidad === 2 ? 8 : 0));
+    m.writeUIntLE(e.indice ?? indice + cantidad, 0, 3);
+    m[3] = e.tipo;
+    if (e.extra !== undefined) {
+      m.writeUIntLE(indice + cantidad + 4, 4, 3);
+      m[7] = e.extra;
+    }
+    const p = 4 * cantidad;
+    m.writeUInt32LE((((e.compresion & 0xf) << 28) | comprimido) >>> 0, p);
+    m.writeUInt32LE(e.tamano, p + 4);
+    m.writeUInt32LE(offsets[i] / 16, p + 12);
+    bloques.push(m);
+    indice += m.length / 4;
+  });
+  const metadatos = Buffer.concat(bloques);
+  // Como un empaquetador: comprimida solo si queda mas chica.
+  const guardar = (t: Buffer) => {
+    const z = zlib.deflateSync(t);
+    return comprimirTablas && z.length < t.length ? z : t;
+  };
+  const tablaZ = guardar(tabla);
+  const metadatosZ = guardar(metadatos);
+  partes.push(tablaZ, metadatosZ);
+
+  const cabecera = partes[0];
+  cabecera.write('SCS#', 0, 'latin1');
+  cabecera.writeUInt16LE(2, 4);
+  cabecera.writeUInt16LE(salt, 6);
+  cabecera.write('CITY', 8, 'latin1');
+  cabecera.writeUInt32LE(entradas.length, 12);
+  cabecera.writeUInt32LE(tablaZ.length, 16);
+  // la cantidad de valores de 4 bytes, no el tamano
+  cabecera.writeUInt32LE(metadatos.length / 4, 20);
+  cabecera.writeUInt32LE(metadatosZ.length, 24);
+  cabecera.writeBigUInt64LE(BigInt(offset), 28);
+  cabecera.writeBigUInt64LE(BigInt(offset + tablaZ.length), 36);
+  const archivo = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'hashfs-v2-')), 'mod.scs');
+  fs.writeFileSync(archivo, Buffer.concat(partes));
+  return archivo;
+}
+
+describe('ScsArchive HashFS v2 protegido', () => {
+  const raiz = listado(['/def', '/map']);
+  const def = listado(['city.sii']);
+  const map = listado(['/usa', 'usa.mbd']);
+  const usa = listado(['sec+0000+0000.base']);
+  const ciudad = Buffer.from('SiiNunit\n{\n}\n', 'utf8');
+  const sector = Buffer.from('sector de mentira', 'latin1');
+
+  function protegido(): string {
+    return hashfsV2([
+      { ruta: '', directorio: true, tipo: DIRECTORY, compresion: ZLIB, datos: zlib.deflateSync(raiz), tamano: raiz.length },
+      { ruta: 'def', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: def, tamano: def.length },
+      // el listado de map sin la marca de directorio, como un archivo mas
+      { ruta: 'map', directorio: false, tipo: PLAIN, compresion: ZLIB, datos: zlib.deflateSync(map), tamano: map.length },
+      { ruta: 'map/usa', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: usa, tamano: usa.length },
+      { ruta: 'def/city.sii', directorio: false, tipo: PLAIN, compresion: NONE, datos: ciudad, tamano: ciudad.length },
+      { ruta: 'map/usa/sec+0000+0000.base', directorio: false, tipo: PLAIN, compresion: NONE, datos: sector, tamano: sector.length },
+      // basura: un "directorio" con la marca de zlib sobre los datos sin
+      // comprimir de def/city.sii (el mismo offset). Antes dejaba afuera el
+      // mod entero con "incorrect header check" (Beyond, 23-11).
+      { ruta: 0x1234_5678_9abc_def0n, directorio: true, tipo: DIRECTORY, compresion: ZLIB, datos: 4, tamano: 4096 },
+      // basura: un tipo de metadatos y una compresion que no existen
+      { ruta: 0x0fed_cba9_8765_4321n, directorio: false, tipo: 0x55, compresion: NONE, datos: 5, tamano: 10 },
+      { ruta: 0x1111_2222_3333_4444n, directorio: true, tipo: DIRECTORY, compresion: 7, datos: 5, tamano: 10 },
+    ]);
+  }
+
+  it('saltea las entradas basura y lee lo demas', () => {
+    const scs = new ScsArchive(protegido(), 'mod.scs');
+    expect(scs.isValid()).toBe(true);
+    const entries = scs.parseEntries();
+    expect(entries.directories.get('')?.subdirectories).toEqual(['def', 'map']);
+    expect(entries.directories.get('def')?.files).toEqual(['city.sii']);
+    expect(entries.directories.get('map/usa')?.files).toEqual(['sec+0000+0000.base']);
+    expect(entries.files.get('def/city.sii')?.read()).toEqual(ciudad);
+    expect(entries.files.get('map/usa/sec+0000+0000.base')?.read()).toEqual(sector);
+    scs.dispose();
+  });
+
+  it('lee como carpeta un listado guardado sin la marca de directorio', () => {
+    const scs = new ScsArchive(protegido(), 'mod.scs');
+    const entries = scs.parseEntries();
+    const mapDir = entries.directories.get('map');
+    expect(mapDir?.subdirectories).toEqual(['usa']);
+    expect(mapDir?.files).toEqual(['usa.mbd']);
+    expect(mapDir?.scsSource).toBe('mod.scs');
+    // un archivo de verdad no pasa por un listado
+    expect(entries.directories.get('def/city.sii')).toBeUndefined();
+    expect(entries.directories.get('no/existe')).toBeUndefined();
+    scs.dispose();
+  });
+});
+
+describe('ScsArchive HashFS v2 sin comprimir o con salt', () => {
+  const raiz = listado(['/def']);
+  const def = listado(['city.sii']);
+  const ciudad = Buffer.from('SiiNunit\n{\n}\n', 'utf8');
+  const entradas: Entrada[] = [
+    { ruta: '', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: raiz, tamano: raiz.length },
+    { ruta: 'def', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: def, tamano: def.length },
+    { ruta: 'def/city.sii', directorio: false, tipo: PLAIN, compresion: NONE, datos: ciudad, tamano: ciudad.length },
+  ];
+
+  function leer(archivo: string) {
+    const scs = new ScsArchive(archivo, 'mod.scs');
+    const entries = scs.parseEntries();
+    expect(entries.directories.get('')?.subdirectories).toEqual(['def']);
+    expect(entries.directories.get('def')?.files).toEqual(['city.sii']);
+    expect(entries.files.get('def/city.sii')?.read()).toEqual(ciudad);
+    scs.dispose();
+  }
+
+  it('con las tablas comprimidas, como siempre', () => {
+    leer(hashfsV2(entradas));
+  });
+
+  it('con las tablas sin comprimir', () => {
+    // El campo de la cabecera es una cantidad y se tomaba como bytes: la tabla
+    // de metadatos se trataba de inflar, "incorrect header check".
+    leer(hashfsV2(entradas, { comprimirTablas: false }));
+  });
+
+  it('con salt', () => {
+    leer(hashfsV2(entradas, { salt: 4321 }));
+    // un salt de mas de 32767 se lee sin signo
+    leer(hashfsV2(entradas, { salt: 40000, comprimirTablas: false }));
+  });
+});
+
+// build.log del 25-11 (ATS, 77 mods): con la 1.5.47 Beyond se abria, pero 22.147
+// entradas de su primer .scs quedaban afuera como basura (casi todos sus sectores) y
+// 872 archivos daban "unsupported compression type 2". Sin los archivos no se sabe
+// cual de estos trucos usa su empaquetador: cada uno se prueba aca.
+describe('ScsArchive HashFS v2: lo que createEntry no acepta', () => {
