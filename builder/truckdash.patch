index 0000000..38c046b
--- /dev/null
+++ b/packages/clis/parser/game-files/zip-entries.ts
@@ -0,0 +1,144 @@
+// Lector de .scs que son ZIP (Coast to Coast, Grand Utopia, las expansiones
+// de Canada, More European Cities...), con la misma forma que las Entries de
+// scs-archive.ts, para que el parser lea el mod tal como lo bajo la persona,
+// sin extraerlo. Lee solo el indice central al abrir y descomprime cada
+// archivo recien cuando se lo piden: un mod de 250 MB no entra entero en
+// memoria. Ignora el flag de cifrado y el CRC, que algunos mods rompen a
+// proposito para que no se abran (Roextended): el juego tampoco los mira.
+
+import fs from 'fs';
+import zlib from 'zlib';
+
+interface ZipFile {
+  offset: number;
+  compSize: number;
+  method: number;
+}
+
+export class ZipEntries {
+  private readonly fd: number;
+  private readonly fileMap = new Map<string, ZipFile>();
+  private readonly dirMap = new Map<
+    string,
+    { subdirectories: Set<string>; files: Set<string> }
+  >();
+  readonly valid: boolean;
+
+  constructor(
+    readonly path: string,
+    readonly scsSource: string,
+  ) {
+    this.fd = fs.openSync(path, 'r');
+    this.valid = this.readCentralDirectory();
+  }
+
+  private readCentralDirectory(): boolean {
+    const size = fs.fstatSync(this.fd).size;
+    const tail = Math.min(size, 65557);
+    const buf = Buffer.alloc(tail);
+    fs.readSync(this.fd, buf, 0, tail, size - tail);
+    let eocd = -1;
+    for (let i = tail - 22; i >= 0; i--) {
+      if (buf.readUInt32LE(i) === 0x06054b50) {
+        eocd = i;
+        break;
+      }
+    }
+    if (eocd < 0) return false;
+    const count = buf.readUInt16LE(eocd + 10);
+    const cdSize = buf.readUInt32LE(eocd + 12);
+    const cdOffset = buf.readUInt32LE(eocd + 16);
+    const cd = Buffer.alloc(cdSize);
+    fs.readSync(this.fd, cd, 0, cdSize, cdOffset);
+    let p = 0;
+    for (let n = 0; n < count && p + 46 <= cd.length; n++) {
+      if (cd.readUInt32LE(p) !== 0x02014b50) return false;
+      const method = cd.readUInt16LE(p + 10);
+      const compSize = cd.readUInt32LE(p + 20);
+      const nameLen = cd.readUInt16LE(p + 28);
+      const extraLen = cd.readUInt16LE(p + 30);
+      const commentLen = cd.readUInt16LE(p + 32);
+      const offset = cd.readUInt32LE(p + 42);
+      const name = cd
+        .toString('utf8', p + 46, p + 46 + nameLen)
+        .replace(/\\/g, '/')
+        .replace(/^\/+/, '');
+      p += 46 + nameLen + extraLen + commentLen;
+      if (!name || name.endsWith('/')) {
+        if (name) this.ensureDir(name.slice(0, -1));
+        continue;
+      }
+      this.fileMap.set(name, { offset, compSize, method });
+      const slash = name.lastIndexOf('/');
+      const dir = slash < 0 ? '' : name.slice(0, slash);
+      this.ensureDir(dir).files.add(name.slice(slash + 1));
+    }
+    return true;
+  }
+
+  // Los ZIP no siempre traen las carpetas como entradas: se arman de las rutas.
+  private ensureDir(dir: string) {
+    let d = this.dirMap.get(dir);
+    if (!d) {
+      d = { subdirectories: new Set(), files: new Set() };
+      this.dirMap.set(dir, d);
+      if (dir) {
+        const slash = dir.lastIndexOf('/');
+        const parent = slash < 0 ? '' : dir.slice(0, slash);
+        this.ensureDir(parent).subdirectories.add(dir.slice(slash + 1));
+      }
+    }
+    return d;
+  }
+
+  private read(f: ZipFile): Buffer {
+    const head = Buffer.alloc(30);
+    fs.readSync(this.fd, head, 0, 30, f.offset);
+    const start = f.offset + 30 + head.readUInt16LE(26) + head.readUInt16LE(28);
+    const data = Buffer.alloc(f.compSize);
+    fs.readSync(this.fd, data, 0, f.compSize, start);
+    if (f.method === 0) return data;
+    if (f.method === 8) return zlib.inflateRawSync(data);
+    throw new Error(
+      `${this.path}: metodo de compresion ${f.method} no soportado`,
+    );
+  }
+
+  isValid() {
+    return this.valid;
+  }
+
+  dispose() {
+    fs.closeSync(this.fd);
+  }
+
+  parseEntries() {
+    return {
+      directories: {
+        get: (key: string) => {
+          const d = this.dirMap.get(key.replace(/^\/+/, ''));
+          if (!d) return undefined;
+          return {
+            type: 'directory' as const,
+            hash: 0n,
+            scsSource: this.scsSource,
+            subdirectories: [...d.subdirectories],
+            files: [...d.files],
+          };
+        },
+      },
+      files: {
+        get: (key: string) => {
+          const f = this.fileMap.get(key.replace(/^\/+/, ''));
+          if (!f) return undefined;
+          return {
+            type: 'file' as const,
+            hash: 0n,
+            scsSource: this.scsSource,
+            read: () => this.read(f),
+          };
+        },
+      },
+    };
+  }
+}
