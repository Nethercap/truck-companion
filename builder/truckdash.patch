+      { ruta: 'def/company.sii', directorio: false, tipo: PLAIN, compresion: ZLIB_HEADERLESS, datos: zlib.deflateRawSync(empresa), tamano: empresa.length },
+      // con el mismo tamano antes y despues: guardado tal cual
+      { ruta: 'def/city.sii', directorio: false, tipo: PLAIN, compresion: ZLIB_HEADERLESS, datos: ciudad, tamano: ciudad.length },
+      ...(z.zstdCompressSync
