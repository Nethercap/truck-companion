index 0000000..fbe53e6
--- /dev/null
+++ b/packages/clis/truckdash-builder/leer-geojson.ts
@@ -0,0 +1,31 @@
+// Lee el GeoJSON del generator de a una linea: writeGeojsonFile escribe un
+// feature por linea porque entero puede no entrar en un string de V8 (512 MB).
+// Lo usan tiles.ts (el armador de la PC) y unir.ts (el taller).
+
+import fs from 'fs';
+import readline from 'readline';
+import type { Feature } from './unir-calles';
+
+export async function leerFeatures<T>(
+  entrada: string,
+  transformar: (f: Feature) => T,
+): Promise<T[]> {
+  const features: T[] = [];
+  const lineas = readline.createInterface({
+    input: fs.createReadStream(entrada, 'utf8'),
+    crlfDelay: Infinity,
+  });
+  for await (const cruda of lineas) {
+    const linea = cruda.trim().replace(/,$/, '');
+    if (linea.length < 2 || linea[0] !== '{' || linea.at(-1) !== '}') continue;
+    const obj = JSON.parse(linea) as {
+      type?: string;
+      features?: Feature[];
+    };
+    if (obj.type === 'Feature')
+      features.push(transformar(obj as unknown as Feature));
+    else if (obj.type === 'FeatureCollection' && obj.features)
+      for (const f of obj.features) features.push(transformar(f)); // un archivo de una sola linea
+  }
+  return features;
+}
