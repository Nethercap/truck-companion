+      // una compresion que no existe, un tipo que no existe
+      { ruta: 0x1111_2222_3333_4444n, directorio: false, tipo: PLAIN, compresion: 9, datos: 3, tamano: 10 },
+      { ruta: 0x0fed_cba9_8765_4321n, directorio: false, tipo: 0x55, compresion: NONE, datos: 3, tamano: 10 },
+      // guardada tal cual pero con dos tamanos distintos (y el indice fuera de la tabla)
+      { ruta: 0x5555_6666_7777_8888n, directorio: false, tipo: PLAIN, compresion: NONE, datos: 3, tamano: 10, indice: 0xff_ffff, extra: 0x42 },
+      // el mismo hash que def/city.sii: gana la entrada que createEntry acepto
+      { ruta: 'def/city.sii', directorio: true, tipo: PLAIN, compresion: NONE, datos: 0, tamano: raiz.length },
