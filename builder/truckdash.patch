@@ -0,0 +1,53 @@
+import { siiText } from '../convert-sii-to-json';
+import { parseSii } from '../sii-parser';
+import { includeDirectiveCollector } from '../sii-visitors';
+
+// Lo inverso de siiText: el mismo XOR con la misma clave que va subiendo.
+function ofuscar3nK(texto: string, clave = 0xa7): Buffer {
+  const datos = Buffer.from(texto, 'utf8');
+  const buf = Buffer.alloc(6 + datos.length);
+  buf.write('3nK', 0, 'utf8');
+  buf[3] = 0x01;
+  buf[5] = clave;
+  let key = clave;
+  for (let i = 0; i < datos.length; i++) {
+    buf[6 + i] = ((((key << 2) ^ (key ^ 0xff)) << 3) ^ key ^ datos[i]) & 0xff;
+    key++;
+  }
+  return buf;
+}
+
+const lista = `SiiNunit
+{
+@include "city/curitiba.sii"
+@include "city/salvador.sii"
+}
+`;
+
+describe('siiText', () => {
+  it('devuelve tal cual un .sii de texto', () => {
+    expect(siiText(Buffer.from(lista, 'utf8'), 'def/city.sii')).toBe(lista);
+  });
+
+  it('desofusca un def/city.sii en 3nK y sus @include se leen', () => {
+    // Un mod de mapa con la lista de ciudades en 3nK cortaba todo el armado
+    // (Mapa BR Brasil 6.1, 19-10).
+    const texto = siiText(ofuscar3nK(lista), 'def/city.sii');
+    expect(texto).toBe(lista);
+    const res = parseSii(texto);
+    expect(res.ok).toBe(true);
+    expect(includeDirectiveCollector.collect(res.cst, 'def')).toEqual([
+      'def/city/curitiba.sii',
+      'def/city/salvador.sii',
+    ]);
+  });
+
+  it('dice el formato de un .sii cifrado o binario', () => {
+    expect(() => siiText(Buffer.from('ScsC....', 'latin1'), 'def/city.sii')).toThrow(
+      /encrypted \(ScsC\)/,
+    );
+    expect(() => siiText(Buffer.from('BSII....', 'latin1'), 'def/city.sii')).toThrow(
+      /binary \(BSII\)/,
+    );
+  });
+});
