diff --git a/packages/clis/parser/game-files/tests/partes-de-mod.test.ts b/packages/clis/parser/game-files/tests/partes-de-mod.test.ts
new file mode 100755
index 0000000..04dde70
--- /dev/null
+++ b/packages/clis/parser/game-files/tests/partes-de-mod.test.ts
@@ -0,0 +1,139 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { elegirPartes, partesDeMod } from '../partes-de-mod';
+import { ZipEntries } from '../zip-entries';
+
+// Un ZIP minimo, sin comprimir: lo que lee ZipEntries (indice central y, de cada
+// archivo, los dos largos de su cabecera).
+function zip(archivos: Record<string, string>): string {
+  const partes: Buffer[] = [];
+  const indice: Buffer[] = [];
+  let offset = 0;
+  for (const [nombre, texto] of Object.entries(archivos)) {
+    const n = Buffer.from(nombre, 'utf8');
+    const datos = Buffer.from(texto, 'utf8');
+    const local = Buffer.alloc(30);
+    local.writeUInt32LE(0x04034b50, 0);
+    local.writeUInt16LE(n.length, 26);
+    partes.push(local, n, datos);
+    const c = Buffer.alloc(46);
+    c.writeUInt32LE(0x02014b50, 0);
+    c.writeUInt32LE(datos.length, 20);
+    c.writeUInt32LE(datos.length, 24);
+    c.writeUInt16LE(n.length, 28);
+    c.writeUInt32LE(offset, 42);
+    indice.push(c, n);
+    offset += 30 + n.length + datos.length;
+  }
+  const cd = Buffer.concat(indice);
+  const fin = Buffer.alloc(22);
+  fin.writeUInt32LE(0x06054b50, 0);
+  fin.writeUInt16LE(Object.keys(archivos).length, 10);
+  fin.writeUInt32LE(cd.length, 12);
+  fin.writeUInt32LE(offset, 16);
+  const archivo = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'partes-')), 'mod.scs');
+  fs.writeFileSync(archivo, Buffer.concat([...partes, cd, fin]));
+  return archivo;
+}
+
+const abrir = (archivos: Record<string, string>) => {
+  const p = zip(archivos);
+  return { p, mod: new ZipEntries(p, 'mod.scs') };
+};
+
+describe('elegirPartes', () => {
+  const dlcs = new Set(['dlc_wa', 'dlc_or']);
+
+  it('un mod comun no viene en partes', () => {
+    expect(elegirPartes(['def', 'map', 'manifest.sii', 'database'], dlcs)).toBeUndefined();
+  });
+
+  it('base primero, despues los DLC que estan en el juego', () => {
+    expect(elegirPartes(['dlc_wa', 'manifest.sii', 'dlc_mt', 'base', 'dlc_or'], dlcs)).toEqual({
+      montadas: ['base', 'dlc_or', 'dlc_wa'],
+      sinDlc: ['dlc_mt'],
+    });
+  });
+
+  it('tambien con los nombres en .zip', () => {
+    expect(elegirPartes(['base.zip', 'dlc_wa.zip', 'dlc_mt.zip', 'icon.jpg'], dlcs)).toEqual({
+      montadas: ['base.zip', 'dlc_wa.zip'],
+      sinDlc: ['dlc_mt.zip'],
+    });
+  });
+});
+
+describe('partesDeMod', () => {
+  it('lee adentro de base (ATS Expansion)', () => {
+    const { mod } = abrir({
+      'manifest.sii': 'SiiNunit {}',
+      'base/def/city.reconlobster.sii': '@include "city/wolfpoint.sui"',
+      'base/def/city/wolfpoint.sui': 'ciudad',
+      'base/map/usa/sec+0000+0000.base': 'sector',
+    });
+    const avisos: string[] = [];
+    const partes = partesDeMod(mod, new Set(['dlc_wa']), t => avisos.push(t));
+    expect(partes.length).toBe(1);
+    const e = partes[0].parseEntries();
+    expect(e.directories.get('')?.subdirectories.slice().sort()).toEqual(['def', 'map']);
+    expect(e.directories.get('def')?.files).toEqual(['city.reconlobster.sii']);
+    expect(e.directories.get('map/usa')?.files).toEqual(['sec+0000+0000.base']);
+    const ciudad = e.files.get('def/city/wolfpoint.sui');
+    expect(ciudad?.read().toString()).toBe('ciudad');
+    expect(e.files.get('/def/city/wolfpoint.sui')?.read().toString()).toBe('ciudad');
+    // El log dice que .scs aportaron mapa: el nombre es el del mod.
+    expect(ciudad?.scsSource).toBe('mod.scs');
+    expect(avisos.length).toBe(1);
+    expect(avisos[0]).toMatch(/en partes, se leen: base$/);
+    partes.forEach(p => p.dispose());
+  });
+
+  it('un dlc_ solo si el DLC esta, y la raiz no se monta', () => {
+    const { mod } = abrir({
+      'def/city.raiz.sii': 'raiz',
+      'base/def/a.sii': 'base',
+      'dlc_wa/def/a.sii': 'wa',
+      'dlc_mt/def/a.sii': 'mt',
+    });
+    const avisos: string[] = [];
+    const partes = partesDeMod(mod, new Set(['dlc_wa', 'dlc_or']), t => avisos.push(t));
+    expect(partes.map(p => p.parseEntries().files.get('def/a.sii')?.read().toString())).toEqual([
+      'base',
+      'wa',
+    ]);
+    expect(partes.some(p => p.parseEntries().files.get('def/city.raiz.sii'))).toBe(false);
+    expect(avisos[0]).toMatch(/base, dlc_wa \(sin el DLC: dlc_mt\)$/);
+    partes.forEach(p => p.dispose());
+  });
+
+  it('un mod comun queda tal cual', () => {
+    const { mod } = abrir({ 'def/a.sii': 'a', 'map/usa.mbd': 'x' });
+    const avisos: string[] = [];
+    expect(partesDeMod(mod, new Set(['dlc_wa']), t => avisos.push(t))).toEqual([mod]);
+    expect(avisos).toEqual([]);
+    mod.dispose();
+  });
+
+  it('avisa de un zip adentro del mod, que no se lee', () => {
+    const { mod } = abrir({ 'base.zip': 'PK', 'manifest.sii': 'x' });
+    const avisos: string[] = [];
+    expect(partesDeMod(mod, new Set(), t => avisos.push(t))).toEqual([mod]);
+    expect(avisos[0]).toMatch(/no se puede leer un zip adentro del mod: base\.zip$/);
+    mod.dispose();
+  });
+
+  it('el archivo se cierra una sola vez', () => {
+    const { mod } = abrir({ 'base/def/a.sii': 'a', 'dlc_wa/def/a.sii': 'b' });
+    let cierres = 0;
+    const cerrar = mod.dispose.bind(mod);
+    mod.dispose = () => {
+      cierres++;
+      cerrar();
+    };
+    const partes = partesDeMod(mod, new Set(['dlc_wa']));
+    expect(partes.length).toBe(2);
+    partes.forEach(p => p.dispose());
+    expect(cierres).toBe(1);
+  });
+});
diff --git a/packages/clis/parser/game-files/tests/scs-archive-v1.test.ts b/packages/clis/parser/game-files/tests/scs-archive-v1.test.ts
new file mode 100644
index 0000000..ad1a987
--- /dev/null
+++ b/packages/clis/parser/game-files/tests/scs-archive-v1.test.ts
@@ -0,0 +1,83 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import zlib from 'zlib';
+import { city64 } from '../cityhash';
+import { inflateComoElJuego, ScsArchive } from '../scs-archive';
+
+// Un zlib "protegido": sin los 4 bytes del adler32 del final.
+function sinFinal(datos: Buffer): Buffer {
+  const z = zlib.deflateSync(datos);
+  return z.subarray(0, z.length - 4);
+}
+
+// Un HashFS v1 con las entradas dadas: cabecera de 20 bytes, los datos y la
+// tabla de 32 bytes por entrada al final (como lo lee parseEntriesV1).
+function hashfsV1(
+  entradas: { ruta: string; datos: Buffer; tamano: number; flags: number }[],
+): string {
+  const partes: Buffer[] = [Buffer.alloc(20)];
+  let offset = 20;
+  const tabla = Buffer.alloc(entradas.length * 32);
+  entradas.forEach((e, i) => {
+    tabla.writeBigUInt64LE(city64(e.ruta), i * 32);
+    tabla.writeBigUInt64LE(BigInt(offset), i * 32 + 8);
+    tabla.writeUInt32LE(e.flags, i * 32 + 16);
+    tabla.writeUInt32LE(e.tamano, i * 32 + 24);
+    tabla.writeUInt32LE(e.datos.length, i * 32 + 28);
+    partes.push(e.datos);
+    offset += e.datos.length;
+  });
+  const cabecera = partes[0];
+  cabecera.write('SCS#', 0, 'latin1');
+  cabecera.writeUInt16LE(1, 4);
+  cabecera.writeUInt16LE(0, 6);
+  cabecera.write('CITY', 8, 'latin1');
+  cabecera.writeUInt32LE(entradas.length, 12);
+  cabecera.writeUInt32LE(offset, 16);
+  partes.push(tabla, Buffer.alloc(64)); // la cabecera de v2 que se lee igual es mas larga
+  const archivo = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'hashfs-v1-')), 'mod.scs');
+  fs.writeFileSync(archivo, Buffer.concat(partes));
+  return archivo;
+}
+
+describe('inflateComoElJuego', () => {
+  const texto = Buffer.from('*def\n*map\nversion.sii\n'.repeat(20), 'utf8');
+
+  it('lee un zlib entero como siempre', () => {
+    expect(inflateComoElJuego(zlib.deflateSync(texto), texto.length)).toEqual(texto);
+  });
+
+  it('lee un zlib sin el final si sale del tamano de la entrada (#135)', () => {
+    expect(() => zlib.inflateSync(sinFinal(texto))).toThrow(/unexpected end of file/);
+    expect(inflateComoElJuego(sinFinal(texto), texto.length)).toEqual(texto);
+  });
+
+  it('tira el error de siempre si lo que sale no es del tamano', () => {
+    const cortado = zlib.deflateSync(texto).subarray(0, 8);
+    expect(() => inflateComoElJuego(cortado, texto.length)).toThrow(/unexpected end of file/);
+  });
+});
+
+describe('ScsArchive HashFS v1', () => {
+  it('lee los listados con el zlib sin final y saltea el que no se puede leer', () => {
+    const raiz = Buffer.from('*def\n*map\n', 'utf8');
+    const def = Buffer.from('city.sii\n', 'utf8');
+    const ciudad = Buffer.from('SiiNunit\n{\n}\n', 'utf8');
+    const archivo = hashfsV1([
+      { ruta: '', datos: sinFinal(raiz), tamano: raiz.length, flags: 1 | 2 },
+      { ruta: 'def', datos: sinFinal(def), tamano: def.length, flags: 1 | 2 },
+      // basura marcada como zlib: antes frenaba todo el armado
+      { ruta: 'map', datos: Buffer.from('no es zlib', 'latin1'), tamano: 40, flags: 1 | 2 },
+      { ruta: 'def/city.sii', datos: sinFinal(ciudad), tamano: ciudad.length, flags: 2 },
+    ]);
+    const scs = new ScsArchive(archivo, 'mod.scs');
+    expect(scs.isValid()).toBe(true);
+    const entries = scs.parseEntries();
+    expect(entries.directories.get('')?.subdirectories).toEqual(['def', 'map']);
