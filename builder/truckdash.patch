+        // del archivo): el de verdad es el de despues
+        { ruta: 'map/usa/sec+0001+0000.base', directorio: false, tipo: PLAIN, compresion: ZLIB, datos: zlib.deflateSync(sector1), tamano: sector1.length, indice: 2 },
