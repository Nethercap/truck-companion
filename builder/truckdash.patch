diff --git a/packages/clis/parser/run-with-mod.ts b/packages/clis/parser/run-with-mod.ts
new file mode 100755
index 0000000..65b2ca1
--- /dev/null
+++ b/packages/clis/parser/run-with-mod.ts
@@ -0,0 +1,211 @@
+#!/usr/bin/env -S NODE_OPTIONS=--max-old-space-size=12288 npx tsx
+// Corre el parser de truckermudgeon/maps incluyendo un mod de mapa que viene
+// como carpeta ya extraida en disco (en vez de un .scs real), inyectandolo
+// como un "archivo" mas via el parametro extraArchives que le agregamos a
+// parseMapFiles (ver map-files-parser.ts.orig para el diff exacto del patch).
+//
+// Por que hace falta esto: el .scs de Coast to Coast es en realidad un ZIP
+// plano, no el formato binario HashFS que usa ScsArchive - y aunque lo fuera,
+// parseMapFiles solo agrega archivos de la lista fija de "requiredFiles" +
+// cualquiera que empiece con "dlc" (ver el filtro scsFilePaths.filter(...)),
+// asi que un mod con otro nombre nunca se hubiera sumado de todos modos.
+//
+// Uso:
+//   npx tsx run-with-mod.ts <atsInputDir> <modExtractedDir> <outputDir>
+
+import { writeArrayFile } from '@truckermudgeon/io';
+import type { MapData } from '@truckermudgeon/map/types';
+import fs from 'fs';
+import path from 'path';
+import { parseMapFiles } from './game-files/map-files-parser';
+import { ScsArchive } from './game-files/scs-archive';
+import { ZipEntries } from './game-files/zip-entries';
+import { logger } from './logger';
+
+// Adaptador Entries/DirectoryEntry/FileEntry (misma forma que exporta
+// scs-archive.ts) respaldado por una carpeta ya extraida en disco, en vez de
+// leer un archivo .scs binario. Solo implementa lo que CombinedEntries y el
+// resto del parser realmente usan: directories.get(path)/files.get(path)
+// devolviendo listados de nombres bases y bytes crudos por archivo.
+class DirEntries {
+  private readonly dirMap = new Map<
+    string,
+    { subdirectories: string[]; files: string[] }
+  >();
+  private readonly fileMap = new Map<string, string>(); // path relativo -> path absoluto en disco
+
+  constructor(private readonly root: string) {
+    this.walk(root, '');
+  }
+
+  private walk(absDir: string, relDir: string) {
+    const entries = fs.readdirSync(absDir, { withFileTypes: true });
+    const subdirectories: string[] = [];
+    const files: string[] = [];
+    for (const entry of entries) {
+      if (entry.isDirectory()) {
+        subdirectories.push(entry.name);
+        const childRel = relDir ? `${relDir}/${entry.name}` : entry.name;
+        this.walk(path.join(absDir, entry.name), childRel);
+      } else if (entry.isFile()) {
+        files.push(entry.name);
+        const childRel = relDir ? `${relDir}/${entry.name}` : entry.name;
+        this.fileMap.set(childRel, path.join(absDir, entry.name));
+      }
+    }
+    this.dirMap.set(relDir, { subdirectories, files });
+  }
+
+  get directories() {
+    return {
+      get: (key: string) => {
+        const d = this.dirMap.get(key);
+        if (!d) return undefined;
+        return {
+          type: 'directory' as const,
+          hash: 0n,
+          scsSource: 'coast_to_coast',
+          subdirectories: d.subdirectories,
+          files: d.files,
+        };
+      },
+    };
+  }
+
+  get files() {
+    return {
+      get: (key: string) => {
+        const abs = this.fileMap.get(key);
+        if (!abs) return undefined;
+        return {
+          type: 'file' as const,
+          hash: 0n,
+          scsSource: 'coast_to_coast',
+          read: () => fs.readFileSync(abs),
+        };
+      },
+    };
+  }
+}
+
+// "Archivo" ficticio compatible con lo que CombinedEntries espera de cada
+// elemento de su lista (isValid/parseEntries/dispose) - parseMapFiles llama
+// a estos tres metodos igual que con un ScsArchive real.
+// Un mod puede venir como carpeta ya extraida (el taller) o como el .scs que
+// bajo la persona (su PC): HashFS v2 se abre con el ScsArchive del parser,
+// que es el mismo formato que los archivos del juego, y un ZIP con
+// ZipEntries. Asi no hace falta extraer nada.
+function createModArchive(modPath: string) {
+  if (fs.statSync(modPath).isFile()) {
+    const magic = Buffer.alloc(4);
+    const fd = fs.openSync(modPath, 'r');
+    fs.readSync(fd, magic, 0, 4, 0);
+    fs.closeSync(fd);
+    const source = path.basename(modPath);
+    if (magic.toString('latin1') === 'SCS#')
+      return abrirOSaltear(modPath, () => new ScsArchive(modPath, source));
+    if (magic[0] === 0x50 && magic[1] === 0x4b)
+      return abrirOSaltear(modPath, () => new ZipEntries(modPath, source));
+    // Uno cifrado o de otro formato (un cruce de tren, no un mapa) frenaba todo.
+    console.warn(`${modPath}: no es un .scs que conozcamos (ni HashFS ni ZIP), se saltea`);
+    return null;
+  }
+  return createDirArchive(modPath);
+}
+
+// El indice de un mod se lee aca, no en la primera busqueda del parser: si
+// uno no se puede leer, se saltea con su nombre. Antes el error salia de
+// parseVersionSii sin decir que archivo era, con 85 mods en la lista (#135).
+function abrirOSaltear<A extends { isValid(): boolean; parseEntries(): unknown; dispose(): void }>(
+  modPath: string,
+  abrir: () => A,
+): A | null {
+  let archive: A | null = null;
+  try {
+    archive = abrir();
+    if (archive.isValid()) archive.parseEntries();
+    return archive;
+  } catch (err) {
+    console.warn(`${modPath}: no se pudo leer (${err instanceof Error ? err.message : String(err)}), se saltea`);
+    archive?.dispose();
+    return null;
+  }
+}
+
+function createDirArchive(extractedDir: string) {
+  const entries = new DirEntries(extractedDir);
+  return {
+    path: extractedDir,
+    isValid: () => true,
+    parseEntries: () => entries,
+    dispose: () => {
+      // una carpeta no tiene nada que cerrar
+    },
+  };
+}
+
+// La lista de mods: separados por coma (el taller, carpetas sin comas en el
+// nombre) o en un archivo con uno por linea, "@lista.txt" (el cliente): el
+// nombre de un mod puede tener comas ("FREE-TM DAF 2021 XF, XG & XG+ ...",
+// #142) y la linea de comandos de Windows no pasa de 32 mil caracteres.
+function listaDeMods(arg: string): string[] {
+  if (!arg.startsWith('@')) return arg.split(',');
+  return fs
+    .readFileSync(arg.slice(1), 'utf8')
+    .split(/\r?\n/)
+    .filter(linea => linea.trim() !== '');
+}
+
+function main() {
+  const [inputDir, modDirsArg, outputDir] = process.argv.slice(2);
+  if (!inputDir || !modDirsArg || !outputDir) {
+    console.error(
+      'Uso: npx tsx run-with-mod.ts <inputDir> <modDir1,modDir2,...|@lista.txt> <outputDir>',
+    );
+    process.exit(1);
+  }
+
+  const scsFilePaths = fs
+    .readdirSync(inputDir, { withFileTypes: true })
+    .filter(e => e.isFile() && e.name.endsWith('.scs'))
+    .map(e => path.join(inputDir, e.name));
+
+  // Varios paquetes de un mismo mod (ej. ProMods viene separado en "map" +
+  // "dlcsupport") van en la lista y se combinan como archivos
+  // independientes - el orden importa para paths duplicados (el ultimo gana,
+  // igual que con .scs reales, ver CombinedEntries.files.get).
+  const modArchives = listaDeMods(modDirsArg).map(createModArchive).filter(a => a !== null);
+
+  const result = parseMapFiles(scsFilePaths, {
+    includeDlc: true,
+    mode: 'all',
+    // extraArchives lo agrega nuestro parche de parseMapFiles.
+    extraArchives: modArchives,
+  });
+
+  if (!fs.existsSync(outputDir)) fs.mkdirSync(outputDir, { recursive: true });
+
+  if (result.data !== 'all') {
+    throw new Error('esperaba mode "all"');
+  }
+  const map = result.map;
+  for (const key of Object.keys(result.mapData)) {
+    const collection = result.mapData[key as keyof MapData];
+    const filename = `${map}-${key}.json`;
+    logger.log('writing', collection.length, `entries to ${filename}...`);
+    writeArrayFile(collection, path.join(outputDir, filename));
+  }
+
+  const pngOutputDir = path.join(outputDir, 'icons');
+  if (!fs.existsSync(pngOutputDir)) fs.mkdirSync(pngOutputDir);
+  logger.log('writing', result.icons.size, `.png files to ${pngOutputDir}...`);
+  for (const [name, buffer] of result.icons) {
+    if (buffer.length === 0) continue; // icono conocido pero sin imagen
+    fs.writeFileSync(path.join(pngOutputDir, name + '.png'), buffer);
+  }
+
+  fs.writeFileSync(path.join(outputDir, `${map}-version.txt`), result.version);
+  logger.success('done.');
+}
+
+main();
