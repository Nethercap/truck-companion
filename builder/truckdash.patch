+// Corre con: node --experimental-strip-types --test packages/clis/truckdash-builder/unir-calles.prueba.ts
+// (build.sh lo corre antes de empaquetar el armador).
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { ATRIBUTOS, unirCalles, type Feature } from './unir-calles.ts';
+
+const calle = (
+  coords: number[][],
+  props: Record<string, unknown> = {},
+): Feature => ({
+  type: 'Feature',
+  properties: { type: 'road', roadType: 'local', hidden: false, ...props },
+  geometry: { type: 'LineString', coordinates: coords },
+});
+const lineas = (fs: Feature[]) =>
+  fs.map(f => (f.geometry as { coordinates: number[][] }).coordinates);
+
+test('dos pedazos que siguen uno al otro quedan en una linea', () => {
+  const r = unirCalles(
+    [
+      calle([
+        [0, 0],
+        [1, 0],
+      ]),
+      calle([
+        [1, 0],
+        [2, 1],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(r.uniones, 1);
+  assert.deepEqual(lineas(r.features), [
+    [
+      [0, 0],
+      [1, 0],
+      [2, 1],
+    ],
+  ]);
+});
+
+test('da igual para que lado va cada pedazo', () => {
+  // punta con punta (las dos ramas de la entrada a una rotonda: la estrella)
+  const v = unirCalles(
+    [
+      calle([
+        [0, 0],
+        [5, 5],
+      ]),
+      calle([
+        [10, 0],
+        [5, 5],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.deepEqual(lineas(v.features), [
+    [
+      [0, 0],
+      [5, 5],
+      [10, 0],
+    ],
+  ]);
+  // principio con principio
+  const p = unirCalles(
+    [
+      calle([
+        [1, 0],
+        [0, 0],
+      ]),
+      calle([
+        [1, 0],
+        [2, 0],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.deepEqual(lineas(p.features), [
+    [
+      [0, 0],
+      [1, 0],
+      [2, 0],
+    ],
+  ]);
+});
+
+test('una cadena de varios pedazos, en cualquier orden', () => {
+  const r = unirCalles(
+    [
+      calle([
+        [2, 0],
+        [3, 0],
+      ]),
+      calle([
+        [0, 0],
+        [1, 0],
+      ]),
+      calle([
+        [2, 0],
+        [1, 0],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(r.uniones, 2);
+  assert.equal(r.features.length, 1);
+  const c = lineas(r.features)[0];
+  // queda donde estaba el primer pedazo del archivo, recorrida de punta a punta
+  assert.deepEqual(c.length, 4);
+  assert.deepEqual(
+    [c[0], c[3]].sort(),
+    [
+      [0, 0],
+      [3, 0],
+    ].sort(),
+  );
+});
+
+test('en un cruce de tres o mas no se une nada', () => {
+  const r = unirCalles(
+    [
+      calle([
+        [0, 0],
+        [1, 0],
+      ]),
+      calle([
+        [1, 0],
+        [2, 0],
+      ]),
+      calle([
+        [1, 0],
+        [1, 1],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(r.uniones, 0);
+  assert.equal(r.features.length, 3);
+});
+
+test('no se unen calles que se dibujan distinto', () => {
+  const tipo = unirCalles(
+    [
+      calle([
+        [0, 0],
+        [1, 0],
+      ]),
+      calle(
+        [
+          [1, 0],
+          [2, 0],
+        ],
+        { roadType: 'freeway' },
+      ),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(tipo.uniones, 0);
+  const dlc = unirCalles(
+    [
+      calle(
+        [
+          [0, 0],
+          [1, 0],
+        ],
+        { dlcGuard: 2 },
+      ),
+      calle(
+        [
+          [1, 0],
+          [2, 0],
+        ],
+        { dlcGuard: 3 },
+      ),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(dlc.uniones, 0);
+  // lo que no viaja en los tiles no cuenta (los carriles de cada pedazo)
+  const carriles = unirCalles(
+    [
+      calle(
+        [
+          [0, 0],
+          [1, 0],
+        ],
+        { leftLanes: 1 },
+      ),
+      calle(
+        [
+          [1, 0],
+          [2, 0],
+        ],
+        { leftLanes: 2 },
+      ),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(carriles.uniones, 1);
+});
+
+test('un anillo de pedazos queda cerrado y entero', () => {
+  const r = unirCalles(
+    [
+      calle([
+        [0, 0],
+        [1, 0],
+      ]),
+      calle([
+        [1, 0],
+        [1, 1],
+      ]),
+      calle([
+        [1, 1],
+        [0, 0],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(r.features.length, 1);
+  const c = lineas(r.features)[0];
+  assert.equal(c.length, 4);
+  assert.deepEqual(c[0], c[3]);
+});
+
+test('puntas casi iguales se juntan, separadas no', () => {
+  const cerca = unirCalles(
+    [
+      calle([
+        [10, 50],
+        [10.001, 50],
+      ]),
+      calle([
+        [10.001 + 1e-9, 50],
+        [10.002, 50],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(cerca.uniones, 1);
+  const lejos = unirCalles(
+    [
+      calle([
+        [10, 50],
+        [10.001, 50],
+      ]),
+      calle([
+        [10.001 + 1e-5, 50],
+        [10.002, 50],
+      ]),
+    ],
+    ATRIBUTOS,
+  );
+  assert.equal(lejos.uniones, 0);
+});
+
+test('lo que no es una calle queda igual y en su lugar', () => {
+  const ciudad: Feature = {
+    type: 'Feature',
+    properties: { type: 'city', name: 'Uppsala' },
+    geometry: { type: 'Point', coordinates: [1, 0] },
+  };
+  const prefab: Feature = {
+    type: 'Feature',
+    properties: { type: 'prefab' },
+    geometry: {
+      type: 'Polygon',
+      coordinates: [
+        [
+          [0, 0],
+          [1, 0],
+          [1, 1],
+          [0, 0],
+        ],
+      ],
+    },
+  };
+  const a = calle([
+      [0, 0],
+      [1, 0],
+    ]),
+    b = calle([
+      [1, 0],
+      [2, 0],
+    ]);
+  const r = unirCalles([ciudad, a, prefab, b], ATRIBUTOS);
+  assert.equal(r.features.length, 3);
+  assert.equal(r.features[0], ciudad);
+  assert.equal(r.features[2], prefab);
+  assert.deepEqual(r.features[1].properties, a.properties);
+  // sin nada que unir devuelve lo mismo
+  const nada = [ciudad, a];
+  assert.equal(unirCalles(nada, ATRIBUTOS).features, nada);
+});
diff --git a/packages/clis/truckdash-builder/unir-calles.ts b/packages/clis/truckdash-builder/unir-calles.ts
