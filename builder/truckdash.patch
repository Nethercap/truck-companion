index 0000000..ac4c174
--- /dev/null
+++ b/packages/clis/truckdash-builder/unir-calles.ts
@@ -0,0 +1,137 @@
+// Junta en una sola linea las calles que se tocan punta con punta. El
+// generator deja cada cruce en pedazos (la calle, las dos ramas de la entrada
+// a una rotonda, el anillo) y cada pedazo es una linea aparte: dibujadas con
+// el ancho de la calle y puntas cuadradas, donde terminan dos juntas en
+// angulo las dos puntas se pisan y queda una estrella (las entradas de las
+// rotondas). Unidas, ahi hay una esquina y la dibuja la union de la linea.
+//
+// Solo donde se juntan exactamente dos puntas y las dos calles se dibujan
+// igual (mismos `claves`: tipo, si esta oculta, el DLC...). En un cruce de
+// tres o mas no se toca nada. Lo usan tiles.ts (el armador de la PC) y unir.ts
+// (el taller, antes de tippecanoe). Sin dependencias: corre con node solo.
+
+// Los -y del taller (tippecanoe) y lo que guarda tiles.ts: el resto de las
+// propiedades no viaja, y dos calles que coinciden en esto se dibujan igual.
+export const ATRIBUTOS = [
+  'type',
+  'dlcGuard',
+  'zIndex',
+  'height',
+  'hidden',
+  'secret',
+  'poiType',
+  'poiName',
+  'sprite',
+  'scaleRank',
+  'capital',
+  'roadType',
+  'color',
+  'name',
+];
+
+export interface Feature {
+  type: 'Feature';
+  geometry: unknown;
+  properties: Record<string, unknown> | null;
+  id?: unknown;
+}
+
+type Punto = number[];
+
+// Dos puntas a menos de esto (en grados, ~0,1 m del mapa y ~5 mm del juego)
+// son el mismo punto: el generator calcula por separado el final de una calle
+// y el nodo del prefab donde empieza la otra.
+const PASO_GRADOS = 1e-6;
+
+function celda(p: Punto): string {
+  return `${Math.round(p[0] / PASO_GRADOS)},${Math.round(p[1] / PASO_GRADOS)}`;
+}
+
+export function unirCalles(
+  features: Feature[],
+  claves: readonly string[],
+): { features: Feature[]; uniones: number } {
+  const firma = (f: Feature) =>
+    JSON.stringify(claves.map(k => f.properties?.[k] ?? null));
+  // Las calles que se pueden unir: LineString de dos puntos o mas.
+  const lineas: number[] = [];
+  const coords: Punto[][] = [];
+  features.forEach((f, i) => {
+    const g = f.geometry as { type?: string; coordinates?: Punto[] } | null;
+    if (
+      f.properties?.type === 'road' &&
+      g?.type === 'LineString' &&
+      Array.isArray(g.coordinates) &&
+      g.coordinates.length >= 2
+    ) {
+      lineas.push(i);
+      coords.push(g.coordinates);
+    }
+  });
+  // Cada punta (linea, 0 = el primer punto, 1 = el ultimo) en su celda.
+  const puntas = new Map<string, [number, 0 | 1][]>();
+  coords.forEach((c, n) => {
+    for (const lado of [0, 1] as const) {
+      const k = celda(lado ? c[c.length - 1] : c[0]);
+      const lista = puntas.get(k);
+      if (lista) lista.push([n, lado]);
+      else puntas.set(k, [[n, lado]]);
+    }
+  });
+  // vecino[n][lado]: con que punta de que linea se une esa punta.
+  const vecino: ([number, 0 | 1] | null)[][] = coords.map(() => [null, null]);
+  let uniones = 0;
+  for (const lista of puntas.values()) {
+    if (lista.length !== 2) continue;
+    const [[a, la], [b, lb]] = lista;
+    if (a === b) continue; // una linea cerrada sobre si misma
+    if (firma(features[lineas[a]]) !== firma(features[lineas[b]])) continue;
+    vecino[a][la] = [b, lb];
+    vecino[b][lb] = [a, la];
+    uniones++;
+  }
+  if (!uniones) return { features, uniones };
+
+  // Se recorre cada cadena desde una punta suelta; lo que queda son anillos.
+  // La linea unida queda en el lugar de su primer pedazo, con sus
+  // propiedades; los demas pedazos salen. El resto, igual y en orden.
+  const usada = new Array(coords.length).fill(false);
+  const unida = new Map<number, Punto[]>(); // feature donde queda -> coordenadas
+  const fuera = new Set<number>();
+  const recorrer = (inicio: number, entraPor: 0 | 1) => {
+    const out: Punto[] = [];
+    let n = inicio,
+      lado = entraPor;
+    while (!usada[n]) {
+      usada[n] = true;
+      const c = lado === 0 ? coords[n] : coords[n].slice().reverse();
+      for (let k = out.length ? 1 : 0; k < c.length; k++) out.push(c[k]);
+      if (n !== inicio) fuera.add(lineas[n]);
+      const v = vecino[n][(1 - lado) as 0 | 1];
+      if (!v) break;
+      [n, lado] = v;
+    }
+    if (out.length > coords[inicio].length) unida.set(lineas[inicio], out);
+  };
+  coords.forEach((_, n) => {
+    if (usada[n]) return;
+    if (!vecino[n][0]) recorrer(n, 0);
+    else if (!vecino[n][1]) recorrer(n, 1);
+  });
+  coords.forEach((_, n) => {
+    if (!usada[n]) recorrer(n, 0); // anillo: todas sus puntas unidas
+  });
+
+  const resultado: Feature[] = [];
+  features.forEach((f, i) => {
+    if (fuera.has(i)) return;
+    const c = unida.get(i);
+    if (!c) resultado.push(f);
+    else
+      resultado.push({
+        ...f,
+        geometry: { type: 'LineString', coordinates: c },
+      });
+  });
+  return { features: resultado, uniones };
+}
