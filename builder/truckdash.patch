+  }
+
+  const carpetas: Entrada[] = [
+    { ruta: '', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: raiz, tamano: raiz.length },
+    { ruta: 'def', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: def, tamano: def.length },
+    { ruta: 'map', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: map, tamano: map.length },
