@@ -0,0 +1,66 @@
+// Leer el GeoJSON del generator por el codigo real (writeGeojsonFile y
+// leerFeatures). Corre con: npx tsx --test packages/clis/truckdash-builder/leer-geojson.prueba.ts
+// (build.sh lo corre antes de empaquetar el armador).
+import { writeGeojsonFile } from '@truckermudgeon/io';
+import assert from 'node:assert/strict';
+import { constants } from 'node:buffer';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { test } from 'node:test';
+import { leerFeatures } from './leer-geojson';
+
+async function enCarpeta(prueba: (archivo: string) => Promise<void>) {
+  const carpeta = fs.mkdtempSync(path.join(os.tmpdir(), 'leer-geojson-'));
+  try {
+    await prueba(path.join(carpeta, 'mapa.geojson'));
+  } finally {
+    fs.rmSync(carpeta, { recursive: true, force: true });
+  }
+}
+
+const punto = (i: number, name: string): GeoJSON.Feature => ({
+  type: 'Feature',
+  properties: { type: 'city', name },
+  geometry: { type: 'Point', coordinates: [i, -i] },
+});
+
+test('lee lo que escribe writeGeojsonFile, en orden y con cada feature transformado', () =>
+  enCarpeta(async archivo => {
+    const features = [punto(1, 'São Paulo, {a}'), punto(2, 'Москва'), punto(3, '[,]')];
+    writeGeojsonFile(archivo, { type: 'FeatureCollection', features });
+    assert.deepEqual(await leerFeatures(archivo, f => f), features);
+    assert.deepEqual(await leerFeatures(archivo, f => f.properties?.name as string), [
+      'São Paulo, {a}',
+      'Москва',
+      '[,]',
+    ]);
+  }));
+
+test('sin features', () =>
+  enCarpeta(async archivo => {
+    writeGeojsonFile(archivo, { type: 'FeatureCollection', features: [] });
+    assert.deepEqual(await leerFeatures(archivo, f => f), []);
+  }));
+
+test('un archivo de una sola linea', () =>
+  enCarpeta(async archivo => {
+    const features = [punto(1, 'a'), punto(2, 'b')];
+    fs.writeFileSync(archivo, JSON.stringify({ type: 'FeatureCollection', features }));
+    assert.deepEqual(await leerFeatures(archivo, f => f), features);
+  }));
+
+test('un GeoJSON de mas de 512 MB', () =>
+  enCarpeta(async archivo => {
+    // Nombres largos, para no tener GB en memoria: el archivo es lo que importa.
+    const nombre = 'ñ'.repeat(500_000);
+    const features = Array.from({ length: 600 }, (_, i) => punto(i, nombre));
+    writeGeojsonFile(archivo, { type: 'FeatureCollection', features });
+    const tam = fs.statSync(archivo).size;
+    assert.ok(tam > constants.MAX_STRING_LENGTH, `el archivo tiene solo ${tam} bytes`);
+    const leidos = await leerFeatures(archivo, f => (f.geometry as GeoJSON.Point).coordinates[0]);
+    assert.deepEqual(
+      leidos,
+      features.map((_, i) => i),
+    );
+  }));
diff --git a/packages/clis/truckdash-builder/leer-geojson.ts b/packages/clis/truckdash-builder/leer-geojson.ts
