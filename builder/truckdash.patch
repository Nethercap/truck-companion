diff --git a/packages/clis/parser/game-files/tests/sector-versions.test.ts b/packages/clis/parser/game-files/tests/sector-versions.test.ts
new file mode 100644
index 0000000..f54d9b7
--- /dev/null
+++ b/packages/clis/parser/game-files/tests/sector-versions.test.ts
@@ -0,0 +1,180 @@
+import { ItemType } from '@truckermudgeon/map/constants';
+import { parseSector } from '../sector-parser';
+
+const LETRAS = '\x000123456789abcdefghijklmnopqrstuvwxyz_';
+
+function u32(n: number): Buffer {
+  const b = Buffer.alloc(4);
+  b.writeUInt32LE(n);
+  return b;
+}
+
+function u64(n: bigint | number): Buffer {
+  const b = Buffer.alloc(8);
+  b.writeBigUInt64LE(BigInt(n));
+  return b;
+}
+
+function token(s: string): Buffer {
+  let n = 0n;
+  [...s].reverse().forEach(c => {
+    n = n * 38n + BigInt(LETRAS.indexOf(c));
+  });
+  return u64(n);
+}
+
+function texto(s: string): Buffer {
+  return Buffer.concat([u64(s.length), Buffer.from(s)]);
+}
+
+// tipo, uid, posiciones, flags y distancia de vista: 57 bytes.
+function cabecera(tipo: ItemType, uid: number): Buffer {
+  return Buffer.concat([u32(tipo), u64(uid), Buffer.alloc(45)]);
+}
+
+function sector(version: number, items: Buffer[], conFinal = true): Buffer {
+  return Buffer.concat([
+    u32(version),
+    u64(0),
+    u32(0),
+    u32(items.length),
+    ...items,
+    u32(0), // nodos
+    ...(conFinal ? [u32(0)] : []), // hijos de las areas de visibilidad, desde 891
+  ]);
+}
+
+// Lo que tiene una curva despues de los nodos, igual en una vieja y en una
+// subcurva de 907 (que suma flags y lo que va despues de las alturas).
+function medioDeCurva(): Buffer {
+  return Buffer.concat([
+    Buffer.alloc(16), // semilla, estiramiento, escala, paso
+    token('mat'),
+    Buffer.alloc(8), // color, giro
+    token('first'),
+    token('last'),
+    token('center'),
+    token('mirada'),
+    u32(2),
+    Buffer.alloc(8), // dos alturas
+  ]);
+}
+
+function nodosDeCurva(): Buffer {
+  return Buffer.concat([u64(1), u64(2), Buffer.alloc(16), Buffer.alloc(4)]);
+}
+
+function curvaVieja(uid: number): Buffer {
+  return Buffer.concat([
+    cabecera(ItemType.Curve, uid),
+    token('0i03a'),
+    nodosDeCurva(),
+    medioDeCurva(),
+  ]);
+}
+
+function curva907(uid: number): Buffer {
+  return Buffer.concat([
+    cabecera(ItemType.Curve, uid),
+    nodosDeCurva(),
+    u32(1), // una subcurva
+    token('0i03a'),
+    u32(0),
+    medioDeCurva(),
+    Buffer.alloc(20),
+  ]);
+}
+
+function cartel(uid: number, conBoards: boolean): Buffer {
+  return Buffer.concat([
+    cabecera(ItemType.Sign, uid),
+    token('modelo'),
+    u64(1),
+    token('look'),
+    token('variant'),
+    Buffer.from([0]), // sin carteles del modelo
+    texto('plantilla'),
+    ...(conBoards ? [u32(0)] : []),
+    u32(1),
+    u32(0),
+    token('area'),
+    u32(1),
+    Buffer.from([5, 0]), // atributo de tipo 5, un texto
+    u32(0),
+    texto('Istanbul'),
+  ]);
+}
+
+function empresa(uid: number, version: number): Buffer {
+  const nombre = token('agronord');
+  const ciudad = token('istanbul');
+  return Buffer.concat([
+    cabecera(ItemType.Company, uid),
+    ...(version < 903
+      ? [nombre, ciudad, u64(7)]
+      : [ciudad, u64(7), nombre]),
+    u64(1),
+    u32(0),
+  ]);
+}
+
+describe('parseSector con formatos viejos', () => {
+  const sinNodos = new Set<bigint>();
+  const curvaEsperada = {
+    model: '0i03a',
+    look: 'mirada',
+    numBuildings: 2,
+  };
+
+  it('lee las curvas de antes de 907 y sigue con el item de despues', () => {
+    const { items } = parseSector(
+      sector(906, [curvaVieja(1), curvaVieja(2)]),
+      sinNodos,
+    );
+    expect(items.map(i => i.uid)).toEqual([1n, 2n]);
+    expect(items[1]).toMatchObject({ subcurves: [curvaEsperada] });
+  });
+
+  it('907 sigue igual', () => {
+    const { items } = parseSector(sector(907, [curva907(1)]), sinNodos);
+    expect(items[0]).toMatchObject({ subcurves: [curvaEsperada] });
+  });
+
+  it('los carteles tienen la lista de boards recien desde 906', () => {
+    for (const [version, conBoards] of [
+      [905, false],
+      [906, true],
+    ] as const) {
+      const { items } = parseSector(
+        sector(version, [cartel(1, conBoards)]),
+        sinNodos,
+      );
+      expect(items[0]).toMatchObject({ textItems: ['Istanbul'] });
+    }
+  });
+
+  it('el nombre de la empresa va primero antes de 903', () => {
+    for (const version of [901, 903]) {
+      const { items } = parseSector(
+        sector(version, [empresa(1, version)]),
+        sinNodos,
+      );
+      expect(items[0]).toMatchObject({
+        token: 'agronord',
+        cityToken: 'istanbul',
+        prefabUid: 7n,
+      });
+    }
+  });
+
+  it('antes de 891 el sector termina en los nodos', () => {
+    const { items } = parseSector(sector(888, [], false), sinNodos);
+    expect(items).toEqual([]);
+  });
+
+  it('un layout que no cierra sigue tirando error', () => {
+    expect(() =>
+      parseSector(sector(906, [curva907(1)]), sinNodos),
+    ).toThrow();
+  });
+});
