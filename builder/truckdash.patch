diff --git a/packages/clis/parser/game-files/partes-de-mod.ts b/packages/clis/parser/game-files/partes-de-mod.ts
new file mode 100755
index 0000000..6f130ce
--- /dev/null
+++ b/packages/clis/parser/game-files/partes-de-mod.ts
@@ -0,0 +1,114 @@
+// Un mod puede traer su contenido en partes: una carpeta "base" y carpetas
+// "dlc_<nombre>" en la raiz, o los mismos nombres en .zip (wiki de SCS, "Mod
+// manager", desde la 1.48). El juego monta cada parte como si fuera un mod
+// aparte: "base" siempre y un "dlc_" solo si esta ese DLC. La raiz no se monta:
+// en el game.log.txt de un mod asi hay un "requested subdirectory" y un "mounted
+// to mod pool" por parte, y ninguno mas. ATS Expansion viene asi: leyendo la raiz
+// no aparecia nada de el, sin ningun aviso, y faltaba entero del mapa armado
+// (Discord, 23-11).
+
+import type { Entries, ScsArchive } from './scs-archive';
+
+export type ModArchive = Pick<
+  ScsArchive,
+  'path' | 'isValid' | 'parseEntries' | 'dispose'
+>;
+
+interface Partes {
+  /** las que se leen, en el orden en que se montan */
+  montadas: string[];
+  /** las de un DLC que no esta en el juego */
+  sinDlc: string[];
+}
+
+/**
+ * Que partes trae un mod, de los nombres de su raiz. `undefined` si no viene en
+ * partes. `dlcs`: los DLC de la carpeta del juego, con el nombre de su .scs sin
+ * la extension ("dlc_wa").
+ */
+export function elegirPartes(
+  nombres: readonly string[],
+  dlcs: ReadonlySet<string>,
+): Partes | undefined {
+  const parte = (n: string) => n.replace(/\.zip$/, '');
+  const todas = [...new Set(nombres)].filter(
+    n => parte(n) === 'base' || parte(n).startsWith('dlc_'),
+  );
+  if (!todas.length) return undefined;
+  const base = todas.filter(n => parte(n) === 'base').sort();
+  const deDlc = todas.filter(n => parte(n) !== 'base').sort();
+  return {
+    montadas: [...base, ...deDlc.filter(n => dlcs.has(parte(n)))],
+    sinDlc: deDlc.filter(n => !dlcs.has(parte(n))),
+  };
+}
+
+/** La linea del build.log de un mod en partes. */
+export function avisoDePartes(modPath: string, { montadas, sinDlc }: Partes): string {
+  return (
+    `${modPath}: en partes, se leen: ${montadas.join(', ') || 'ninguna'}` +
+    (sinDlc.length ? ` (sin el DLC: ${sinDlc.join(', ')})` : '')
+  );
+}
+
+function conPrefijo(entries: Entries, prefijo: string): Entries {
+  const ruta = (key: string) => {
+    const k = key.replace(/^\/+/, '');
+    return k ? `${prefijo}/${k}` : prefijo;
+  };
+  return {
+    directories: { get: key => entries.directories.get(ruta(key)) },
+    files: { get: key => entries.files.get(ruta(key)) },
+  };
+}
+
+/**
+ * Las partes de un mod que es un solo archivo (.scs o .zip), o el mod tal cual
+ * si no viene en partes.
+ */
+export function partesDeMod(
+  mod: ModArchive,
+  dlcs: ReadonlySet<string>,
+  avisar: (texto: string) => void = () => undefined,
+): ModArchive[] {
+  if (!mod.isValid()) return [mod];
+  const entries = mod.parseEntries();
+  const raiz = entries.directories.get('');
+  // Por nombre y no solo por el listado de la raiz: a un mod protegido le puede
+  // faltar, y sus carpetas se encuentran igual por el hash de la ruta.
+  const partes = elegirPartes(
+    ['base', ...dlcs, ...(raiz?.subdirectories ?? [])].filter(n =>
+      entries.directories.get(n),
+    ),
+    dlcs,
+  );
+  // Un zip adentro de otro archivo no se lee: que por lo menos quede dicho.
+  const zips = elegirPartes(
+    (raiz?.files ?? []).filter(f => f.endsWith('.zip')),
+    dlcs,
+  );
+  if (zips) {
+    avisar(
+      `${mod.path}: no se puede leer un zip adentro del mod: ${[...zips.montadas, ...zips.sinDlc].join(', ')}`,
+    );
+  }
+  if (!partes) return [mod];
+
+  avisar(avisoDePartes(mod.path, partes));
+  if (!partes.montadas.length) {
+    mod.dispose();
+    return [];
+  }
+  return partes.montadas.map((nombre, i) => {
+    const parte = conPrefijo(entries, nombre);
+    return {
+      path: `${mod.path}/${nombre}`,
+      isValid: () => true,
+      parseEntries: () => parte,
+      // El archivo es uno solo: lo cierra la primera.
+      dispose: () => {
+        if (i === 0) mod.dispose();
+      },
+    };
+  });
+}
