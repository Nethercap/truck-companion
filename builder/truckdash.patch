+// Pruebas de ruta-textura.ts. node --experimental-strip-types --test
+
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { rutaDeTextura, texturaDelMaterial } from './ruta-textura.ts';
+
+test('relativa a la carpeta del .mat, como las del juego', () => {
+  assert.equal(rutaDeTextura('material/ui/company/small', 'acm.tobj'), 'material/ui/company/small/acm.tobj');
+  assert.equal(rutaDeTextura('material/ui/map/road', 'road_a_a1.tobj'), 'material/ui/map/road/road_a_a1.tobj');
+});
+
+test('desde la raiz si empieza con "/" (Mapa BR Brasil 6.2, Discord 14-11)', () => {
+  assert.equal(
+    rutaDeTextura('material/ui/company/small', '/material/ui/company/small/bnr.tobj'),
+    'material/ui/company/small/bnr.tobj',
+  );
+  assert.equal(rutaDeTextura('material/ui/company/small', '//material/ui/x.tobj'), 'material/ui/x.tobj');
+});
+
+test('con ".." o "./" en el medio', () => {
+  assert.equal(rutaDeTextura('material/ui/company/small', '../big/acm.tobj'), 'material/ui/company/big/acm.tobj');
+  assert.equal(rutaDeTextura('material/ui/company/small', './acm.tobj'), 'material/ui/company/small/acm.tobj');
