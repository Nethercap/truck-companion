@@ -0,0 +1,164 @@
+// Escribir y leer arreglos de a pedazos, por el codigo real (writeArrayFile y
+// readMapData). Corre con: npx tsx --test packages/libs/io/arreglo-json.prueba.ts
+// (build.sh lo corre antes de empaquetar el armador).
+import assert from 'node:assert/strict';
+import { constants } from 'node:buffer';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { test } from 'node:test';
+import { parseJsonArray } from './arreglo-json';
+import { fromDir, readMapData, writeArrayFile } from './index';
+
+function enCarpeta(prueba: (carpeta: string) => void) {
+  const carpeta = fs.mkdtempSync(path.join(os.tmpdir(), 'arreglo-json-'));
+  try {
+    prueba(carpeta);
+  } finally {
+    fs.rmSync(carpeta, { recursive: true, force: true });
+  }
+}
+
+const trozos = (texto: string, tam: number) => {
+  const bytes = Buffer.from(texto);
+  const salida: Buffer[] = [];
+  for (let i = 0; i < bytes.length; i += tam) {
+    salida.push(bytes.subarray(i, i + tam));
+  }
+  return salida;
+};
+
+// Comas, llaves y comillas adentro de strings, un corchete suelto, letras de
+// varios bytes y elementos que no son objetos.
+const DIFICIL = [
+  { a: 'coma, adentro', 'clave,rara': ['[', ']', '{', '}', '"', '\\', '\\"'] },
+  [1, [2, [3, []]], {}],
+  'São Paulo, Köln — Москва 東京 🚚',
+  12.5,
+  null,
+  true,
+  '',
+  { uid: 'abc', vacio: {}, lista: [] },
+];
+
+test('parseJsonArray da lo mismo que JSON.parse con cualquier corte de pedazos', () => {
+  for (const espacio of [0, 2]) {
+    const texto = JSON.stringify(DIFICIL, null, espacio);
+    for (let tam = 1; tam <= 40; tam++) {
+      assert.deepEqual(parseJsonArray(trozos(texto, tam)), DIFICIL, `corte ${tam}`);
+    }
+    assert.deepEqual(parseJsonArray([Buffer.from(texto)]), DIFICIL);
+  }
+});
+
+test('parseJsonArray: blancos, vacios y un elemento mas largo que el pedazo', () => {
+  assert.deepEqual(parseJsonArray([Buffer.from('[]')]), []);
+  assert.deepEqual(parseJsonArray(trozos(' \r\n\t[ \n ] \r\n', 1)), []);
+  assert.deepEqual(parseJsonArray(trozos(' [ 1 , 2 ]\n', 3)), [1, 2]);
+  const largo = 'x'.repeat(100_000);
+  assert.deepEqual(parseJsonArray(trozos(JSON.stringify([largo, 1]), 7_000)), [largo, 1]);
+});
+
+test('parseJsonArray rechaza lo que JSON.parse rechaza', () => {
+  for (const malo of [
+    '',
+    '   ',
+    '{}',
+    '"[1]"',
+    '[',
+    '[1',
+    '[1,',
+    '[1,]',
+    '[,1]',
+    '[,]',
+    '[1,,2]',
+    '[1 2]',
+    '[{]}',
+    '[1]]',
+    '[1] 2',
+    '["sin cerrar]',
+  ]) {
+    for (const tam of [1, 2, 100]) {
+      assert.throws(() => parseJsonArray(trozos(malo, tam)), SyntaxError, `${malo} de a ${tam}`);
+    }
+  }
+});
+
+test('parseJsonArray: el reviver llega a cada elemento', () => {
+  const texto = JSON.stringify([{ uid: 'ff' }, { uid: '10', n: [{ otroUid: 'a' }] }]);
+  const reviver = (clave: string, valor: unknown) =>
+    clave.endsWith('id') || clave.endsWith('Uid') ? BigInt(`0x${valor as string}`) : valor;
+  assert.deepEqual(parseJsonArray(trozos(texto, 5), reviver), [
+    { uid: 255n },
+    { uid: 16n, n: [{ otroUid: 10n }] },
+  ]);
+});
+
+test('writeArrayFile escribe byte a byte lo de JSON.stringify(array, null, 2)', () => {
+  enCarpeta(carpeta => {
+    const archivo = path.join(carpeta, 'a.json');
+    const conHuecos = [1, undefined, () => 1, { a: undefined, b: 2 }];
+    // Mas que WRITE_CHUNK_CHARS, para que escriba mas de un pedazo.
+    const grande = Array.from({ length: 30 }, (_, i) => ({ i, texto: 'ñ'.repeat(100_000) }));
+    for (const arreglo of [[], [1], DIFICIL, conHuecos, grande]) {
+      writeArrayFile(arreglo as never, archivo);
+      assert.equal(fs.readFileSync(archivo, 'utf8'), JSON.stringify(arreglo, null, 2));
+    }
+  });
+});
+
+test('writeArrayFile sobreescribe un archivo mas largo', () => {
+  enCarpeta(carpeta => {
+    const archivo = path.join(carpeta, 'a.json');
+    fs.writeFileSync(archivo, 'x'.repeat(1000));
+    writeArrayFile([1] as never, archivo);
+    assert.equal(fs.readFileSync(archivo, 'utf8'), '[\n  1\n]');
+  });
+});
+
+test('fromDir.readChunks devuelve el archivo tal cual y lo suelta si se corta a medias', () => {
+  enCarpeta(carpeta => {
+    const contenido = Buffer.alloc(3 * 1024 * 1024 + 123, 'ñ');
+    fs.writeFileSync(path.join(carpeta, 'a'), contenido);
+    fs.writeFileSync(path.join(carpeta, 'vacio'), '');
+    const fuente = fromDir(carpeta);
+    assert.ok(Buffer.concat([...fuente.readChunks('a')]).equals(contenido));
+    assert.deepEqual([...fuente.readChunks('vacio')], []);
+    for (const _ of fuente.readChunks('a')) break;
+  });
+});
+
+// Un nodo como los de europe-nodes.json, que es el archivo mas grande.
+const nodo = (i: number) => ({
+  uid: (0x5a00000000000000n + BigInt(i)).toString(16),
+  x: -41234.5625 + i,
+  y: 18234.3828125 - i,
+  z: 123.45703125,
+  rotation: 2.7960175648368786,
+  rotationQuat: [0.575005292892456, 0, 0.8181496858596802, 0],
+  forwardItemUid: (0x4b00000000000000n + BigInt(i)).toString(16),
+  backwardItemUid: (0x3c00000000000000n + BigInt(i)).toString(16),
+  forwardCountryId: 13,
+  backwardCountryId: 13,
+});
+
+test('un arreglo de mas de 512 MB se escribe y se lee con readMapData', () => {
+  enCarpeta(carpeta => {
+    const nodos = Array.from({ length: 1_800_000 }, (_, i) => nodo(i));
+    writeArrayFile(nodos as never, path.join(carpeta, 'usa-nodes.json'));
+    for (const vacio of ['usa-cities.json', 'usa-companies.json']) {
+      writeArrayFile([] as never, path.join(carpeta, vacio));
+    }
+    const tam = fs.statSync(path.join(carpeta, 'usa-nodes.json')).size;
+    assert.ok(tam > constants.MAX_STRING_LENGTH, `el archivo tiene solo ${tam} bytes`);
+
+    const leido = readMapData(carpeta, 'usa', { mapDataKeys: ['nodes'] }).nodes;
+    assert.equal(leido.size, nodos.length);
+    for (const i of [0, 1_000_000, nodos.length - 1]) {
+      const uid = BigInt(`0x${nodos[i].uid}`);
+      const n = leido.get(uid)!;
+      assert.equal(n.x, nodos[i].x);
+      assert.equal(n.forwardItemUid, BigInt(`0x${nodos[i].forwardItemUid}`));
+    }
+  });
+});
diff --git a/packages/libs/io/arreglo-json.ts b/packages/libs/io/arreglo-json.ts
new file mode 100644
index 0000000..45c9e3f
--- /dev/null
+++ b/packages/libs/io/arreglo-json.ts
@@ -0,0 +1,101 @@
+// Leer un arreglo JSON de un archivo de cualquier tamano: V8 no puede tener un
+// string de mas de 512 MB, asi que JSON.parse(leer todo) no llega. Se parsea de
+// a tandas: las que entran en un pedazo de bytes y terminan en una coma del
+// arreglo de afuera. Lo que no encaja (una coma de mas, llaves cruzadas) lo sigue
+// rechazando JSON.parse, que parsea cada tanda.
+//
+// Se mira byte a byte y no hace falta decodificar: en UTF-8 los bytes de una
+// letra acentuada nunca se confunden con una comilla o una llave.
+
+type Reviver = (this: unknown, key: string, value: unknown) => unknown;
+
+const COMILLA = 0x22;
+const COMA = 0x2c;
+const BARRA = 0x5c;
+const ABRE_CORCHETE = 0x5b;
+const CIERRA_CORCHETE = 0x5d;
+const ABRE_LLAVE = 0x7b;
+const CIERRA_LLAVE = 0x7d;
+
+function esBlanco(byte: number): boolean {
+  return byte === 0x20 || byte === 0x0a || byte === 0x0d || byte === 0x09;
+}
+
+/** Los elementos del arreglo JSON que traen los pedazos, de cualquier tamano. */
+export function parseJsonArray(
+  pedazos: Iterable<Buffer>,
+  reviver?: Reviver,
+): unknown[] {
+  const resultado: unknown[] = [];
+  // Los bytes de la tanda que todavia no se parseo.
+  let pendientes: Buffer[] = [];
+  let abrio = false; // ya se vio el corchete que abre
+  let termino = false; // ya se vio el que cierra
+  let hayComa = false;
+  let enString = false;
+  let escapado = false;
+  let profundidad = 0;
+
+  const parsear = (ultimo: Buffer) => {
+    const texto = Buffer.concat([...pendientes, ultimo]).toString('utf8');
+    const tanda = JSON.parse(`[${texto}]`, reviver) as unknown[];
+    // Vacia despues de una coma: "[1,]" o "[,1]". JSON.parse no la ve porque la
+    // coma quedo afuera de la tanda.
+    if (tanda.length === 0 && hayComa) {
+      throw new SyntaxError('coma de mas en el arreglo JSON');
+    }
+    // Con un for: push(...tanda) pasa del limite de argumentos de una llamada.
+    for (const elemento of tanda) resultado.push(elemento);
+    pendientes = [];
+  };
+
+  for (const pedazo of pedazos) {
+    let desde = 0;
+    let ultimaComa = -1;
+    let cierre = -1;
+    for (let i = 0; i < pedazo.length; i++) {
+      const byte = pedazo[i];
+      if (termino) {
+        if (!esBlanco(byte)) {
+          throw new SyntaxError('hay algo despues del arreglo JSON');
+        }
+      } else if (enString) {
+        if (escapado) escapado = false;
+        else if (byte === BARRA) escapado = true;
+        else if (byte === COMILLA) enString = false;
+      } else if (!abrio) {
+        if (byte === ABRE_CORCHETE) {
+          abrio = true;
+          profundidad = 1;
+          desde = i + 1;
+        } else if (!esBlanco(byte)) {
+          throw new SyntaxError('el archivo no es un arreglo JSON');
+        }
+      } else if (byte === COMILLA) {
+        enString = true;
+      } else if (byte === ABRE_CORCHETE || byte === ABRE_LLAVE) {
+        profundidad++;
+      } else if (byte === CIERRA_CORCHETE || byte === CIERRA_LLAVE) {
+        profundidad--;
+        if (profundidad === 0) {
+          termino = true;
+          cierre = i;
+        }
+      } else if (byte === COMA && profundidad === 1) {
+        ultimaComa = i;
+      }
+    }
+    if (ultimaComa >= 0) {
+      hayComa = true;
+      parsear(pedazo.subarray(desde, ultimaComa));
+      desde = ultimaComa + 1;
+    }
+    if (cierre >= 0) {
+      parsear(pedazo.subarray(desde, cierre));
+    } else if (abrio && !termino) {
+      pendientes.push(pedazo.subarray(desde));
+    }
+  }
+  if (!termino) throw new SyntaxError('el arreglo JSON no termina');
+  return resultado;
+}
