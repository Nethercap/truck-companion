+    expect(entries.directories.get('map/usa')?.files).toEqual(['sec+0000+0000.base', 'sec+0001+0000.base']);
+    expect(entries.files.get('def/company.sii')?.read()).toEqual(empresa);
+    expect(entries.files.get('def/city.sii')?.read()).toEqual(ciudad);
