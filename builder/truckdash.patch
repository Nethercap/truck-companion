+
+  function leer(entradas: Entrada[], opciones = {}) {
+    const scs = new ScsArchive(hashfsV2(entradas, opciones), 'mod.scs');
+    const warn = vi.spyOn(logger, 'warn').mockImplementation(() => undefined);
+    try {
+      return { entries: scs.parseEntries(), avisos: warn.mock.calls.map(c => c.join(' ')) };
+    } finally {
