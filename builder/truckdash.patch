+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import zlib from 'zlib';
+import { city64 } from '../cityhash';
+import { inflateComoElJuego, ScsArchive } from '../scs-archive';
+
+// Un zlib "protegido": sin los 4 bytes del adler32 del final.
+function sinFinal(datos: Buffer): Buffer {
+  const z = zlib.deflateSync(datos);
+  return z.subarray(0, z.length - 4);
+}
+
+// Un HashFS v1 con las entradas dadas: cabecera de 20 bytes, los datos y la
+// tabla de 32 bytes por entrada al final (como lo lee parseEntriesV1).
+function hashfsV1(
+  entradas: { ruta: string; datos: Buffer; tamano: number; flags: number }[],
+): string {
+  const partes: Buffer[] = [Buffer.alloc(20)];
+  let offset = 20;
+  const tabla = Buffer.alloc(entradas.length * 32);
+  entradas.forEach((e, i) => {
+    tabla.writeBigUInt64LE(city64(e.ruta), i * 32);
+    tabla.writeBigUInt64LE(BigInt(offset), i * 32 + 8);
+    tabla.writeUInt32LE(e.flags, i * 32 + 16);
+    tabla.writeUInt32LE(e.tamano, i * 32 + 24);
+    tabla.writeUInt32LE(e.datos.length, i * 32 + 28);
+    partes.push(e.datos);
+    offset += e.datos.length;
+  });
+  const cabecera = partes[0];
+  cabecera.write('SCS#', 0, 'latin1');
+  cabecera.writeUInt16LE(1, 4);
+  cabecera.writeUInt16LE(0, 6);
+  cabecera.write('CITY', 8, 'latin1');
+  cabecera.writeUInt32LE(entradas.length, 12);
+  cabecera.writeUInt32LE(offset, 16);
+  partes.push(tabla, Buffer.alloc(64)); // la cabecera de v2 que se lee igual es mas larga
+  const archivo = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'hashfs-v1-')), 'mod.scs');
+  fs.writeFileSync(archivo, Buffer.concat(partes));
+  return archivo;
+}
+
+describe('inflateComoElJuego', () => {
+  const texto = Buffer.from('*def\n*map\nversion.sii\n'.repeat(20), 'utf8');
+
+  it('lee un zlib entero como siempre', () => {
+    expect(inflateComoElJuego(zlib.deflateSync(texto), texto.length)).toEqual(texto);
+  });
+
+  it('lee un zlib sin el final si sale del tamano de la entrada (#135)', () => {
+    expect(() => zlib.inflateSync(sinFinal(texto))).toThrow(/unexpected end of file/);
+    expect(inflateComoElJuego(sinFinal(texto), texto.length)).toEqual(texto);
+  });
+
+  it('tira el error de siempre si lo que sale no es del tamano', () => {
+    const cortado = zlib.deflateSync(texto).subarray(0, 8);
+    expect(() => inflateComoElJuego(cortado, texto.length)).toThrow(/unexpected end of file/);
+  });
+});
+
+describe('ScsArchive HashFS v1', () => {
+  it('lee los listados con el zlib sin final y saltea el que no se puede leer', () => {
+    const raiz = Buffer.from('*def\n*map\n', 'utf8');
+    const def = Buffer.from('city.sii\n', 'utf8');
+    const ciudad = Buffer.from('SiiNunit\n{\n}\n', 'utf8');
+    const archivo = hashfsV1([
+      { ruta: '', datos: sinFinal(raiz), tamano: raiz.length, flags: 1 | 2 },
+      { ruta: 'def', datos: sinFinal(def), tamano: def.length, flags: 1 | 2 },
+      // basura marcada como zlib: antes frenaba todo el armado
+      { ruta: 'map', datos: Buffer.from('no es zlib', 'latin1'), tamano: 40, flags: 1 | 2 },
+      { ruta: 'def/city.sii', datos: sinFinal(ciudad), tamano: ciudad.length, flags: 2 },
+    ]);
+    const scs = new ScsArchive(archivo, 'mod.scs');
+    expect(scs.isValid()).toBe(true);
+    const entries = scs.parseEntries();
+    expect(entries.directories.get('')?.subdirectories).toEqual(['def', 'map']);
+    expect(entries.directories.get('def')?.files).toEqual(['city.sii']);
+    expect(entries.directories.get('map')).toBeUndefined();
+    expect(entries.files.get('def/city.sii')?.read()).toEqual(ciudad);
+    scs.dispose();
+  });
+});
