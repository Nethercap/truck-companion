+// Lo justo de geojson-vt y vt-pbf que usa tiles.ts (no traen tipos).
+declare module 'geojson-vt' {
+  interface Tile {
+    features: unknown[];
+  }
+  interface Index {
+    getTile(z: number, x: number, y: number): Tile | null;
+  }
+  interface Options {
+    maxZoom?: number;
+    indexMaxZoom?: number;
+    indexMaxPoints?: number;
+    tolerance?: number;
+    extent?: number;
+    buffer?: number;
+  }
+  export default function geojsonvt(data: unknown, options?: Options): Index;
+}
+
+declare module 'vt-pbf' {
+  const vtpbf: {
+    fromGeojsonVt(
+      layers: Record<string, unknown>,
+      options?: { version?: number; extent?: number },
+    ): Uint8Array;
+  };
+  export default vtpbf;
+}
