diff --git a/packages/clis/parser/game-files/cityhash.ts b/packages/clis/parser/game-files/cityhash.ts
new file mode 100755
index 0000000..e0b2d29
--- /dev/null
+++ b/packages/clis/parser/game-files/cityhash.ts
@@ -0,0 +1,133 @@
+// CityHash64 (la version de cityhash/city.cc, la que usa HashFS para ubicar
+// cada archivo) en TypeScript con BigInt. Reemplaza al modulo nativo cuando
+// el parser corre en la PC de quien juega: un .node compilado para Linux no
+// carga en Windows, y asi el armador es un solo .js para cualquier sistema.
+// Se comprueba contra el nativo en cityhash.test.ts.
+
+const M = (1n << 64n) - 1n;
+const k0 = 0xc3a5c85c97cb3127n;
+const k1 = 0xb492b66fbe98f273n;
+const k2 = 0x9ae16a3b2f90404fn;
+const k3 = 0xc949d7c7509e6557n;
+const kMul = 0x9ddfea08eb382d69n;
+
+const mul = (a: bigint, b: bigint) => (a * b) & M;
+const add = (...xs: bigint[]) => xs.reduce((s, x) => s + x, 0n) & M;
+const sub = (a: bigint, b: bigint) => (a - b) & M;
+const rot = (v: bigint, s: number) =>
+  s === 0 ? v : ((v >> BigInt(s)) | (v << BigInt(64 - s))) & M;
+const shiftMix = (v: bigint) => v ^ (v >> 47n);
+
+function hash128to64(lo: bigint, hi: bigint): bigint {
+  let a = mul(lo ^ hi, kMul);
+  a ^= a >> 47n;
+  let b = mul(hi ^ a, kMul);
+  b ^= b >> 47n;
+  return mul(b, kMul);
+}
+const hashLen16 = (u: bigint, v: bigint) => hash128to64(u, v);
+
+export function city64(texto: string): bigint {
+  const s = Buffer.from(texto, 'utf8');
+  const f64 = (p: number) => s.readBigUInt64LE(p);
+  const f32 = (p: number) => BigInt(s.readUInt32LE(p));
+  const len = s.length;
+  const L = BigInt(len);
+
+  if (len <= 16) {
+    if (len > 8) {
+      const a = f64(0);
+      const b = f64(len - 8);
+      return hashLen16(a, rot(add(b, L), len % 64)) ^ b;
+    }
+    if (len >= 4) {
+      const a = f32(0);
+      return hashLen16(add(L, (a << 3n) & M), f32(len - 4));
+    }
+    if (len > 0) {
+      const a = BigInt(s[0]);
+      const b = BigInt(s[len >> 1]);
+      const c = BigInt(s[len - 1]);
+      const y = (a + (b << 8n)) & 0xffffffffn;
+      const z = (L + (c << 2n)) & 0xffffffffn;
+      return mul(shiftMix(mul(y, k2) ^ mul(z, k3)), k2);
+    }
+    return k2;
+  }
+  if (len <= 32) {
+    const a = mul(f64(0), k1);
+    const b = f64(8);
+    const c = mul(f64(len - 8), k2);
+    const d = mul(f64(len - 16), k0);
+    return hashLen16(
+      add(rot(sub(a, b), 43), rot(c, 30), d),
+      (sub(add(a, rot(b ^ k3, 20)), c) + L) & M,
+    );
+  }
+  if (len <= 64) {
+    let z = f64(24);
+    let a = add(f64(0), mul(add(L, f64(len - 16)), k0));
+    let b = rot(add(a, z), 52);
+    let c = rot(a, 37);
+    a = add(a, f64(8));
+    c = add(c, rot(a, 7));
+    a = add(a, f64(16));
+    const vf = add(a, z);
+    const vs = add(b, rot(a, 31), c);
+    a = add(f64(16), f64(len - 32));
+    z = f64(len - 8);
+    b = rot(add(a, z), 52);
+    c = rot(a, 37);
+    a = add(a, f64(len - 24));
+    c = add(c, rot(a, 7));
+    a = add(a, f64(len - 16));
+    const wf = add(a, z);
+    const ws = add(b, rot(a, 31), c);
+    const r = shiftMix(add(mul(add(vf, ws), k2), mul(add(wf, vs), k0)));
+    return mul(shiftMix(add(mul(r, k0), vs)), k2);
+  }
+
+  const weak = (
+    w: bigint,
+    x: bigint,
+    y: bigint,
+    z: bigint,
+    a: bigint,
+    b: bigint,
+  ): [bigint, bigint] => {
+    a = add(a, w);
+    b = rot(add(b, a, z), 21);
+    const c = a;
+    a = add(a, x);
+    a = add(a, y);
+    b = add(b, rot(a, 44));
+    return [add(a, z), add(b, c)];
+  };
+  const weakAt = (p: number, a: bigint, b: bigint) =>
+    weak(f64(p), f64(p + 8), f64(p + 16), f64(p + 24), a, b);
+
+  let x = f64(len - 40);
+  let y = add(f64(len - 16), f64(len - 56));
+  let z = hashLen16(add(f64(len - 48), L), f64(len - 24));
+  let v = weakAt(len - 64, L, z);
+  let w = weakAt(len - 32, add(y, k1), x);
+  x = add(mul(x, k1), f64(0));
+  let resto = (len - 1) & ~63;
+  let p = 0;
+  do {
+    x = mul(rot(add(x, y, v[0], f64(p + 8)), 37), k1);
+    y = mul(rot(add(y, v[1], f64(p + 48)), 42), k1);
+    x ^= w[1];
+    y = add(y, v[0], f64(p + 40));
+    z = mul(rot(add(z, w[0]), 33), k1);
+    v = weakAt(p, mul(v[1], k1), add(x, w[0]));
+    w = weakAt(p + 32, add(z, w[1]), add(y, f64(p + 16)));
+    [z, x] = [x, z];
+    p += 64;
+    resto -= 64;
+  } while (resto !== 0);
+  return hashLen16(
+    add(hashLen16(v[0], w[0]), mul(shiftMix(y), k1), z),
+    add(hashLen16(v[1], w[1]), x),
+  );
+}
