+  });
+
+  it('con el PlainMeta justo despues aunque el encabezado diga otro lugar', () => {
+    const { entries, avisos } = leer(
+      [
+        ...carpetas,
+        { ruta: 'map/usa', directorio: true, tipo: DIRECTORY, compresion: NONE, datos: usa, tamano: usa.length, indice: 0xff_ffff },
+        { ruta: 'map/usa/sec+0000+0000.base', directorio: false, tipo: PLAIN, compresion: NONE, datos: sector0, tamano: sector0.length, indice: 0xff_ffff },
