+test('la textura de un material ui, tambien escrita como lista (RTC, build.log del 16-11)', () => {
+  assert.equal(texturaDelMaterial('road_a_a1.tobj'), 'road_a_a1.tobj');
+  assert.equal(texturaDelMaterial(['road_rtc_kazflag.tobj']), 'road_rtc_kazflag.tobj');
+  assert.equal(
+    rutaDeTextura('material/ui/map/road', texturaDelMaterial(['road_rtc_kazflag.tobj'])),
+    'material/ui/map/road/road_rtc_kazflag.tobj',
+  );
+});
