diff --git a/packages/clis/truckdash-builder/tiles.ts b/packages/clis/truckdash-builder/tiles.ts
new file mode 100755
index 0000000..f78a301
--- /dev/null
+++ b/packages/clis/truckdash-builder/tiles.ts
@@ -0,0 +1,304 @@
+// Tiles vectoriales (.pmtiles) a partir del GeoJSON del generator, sin
+// tippecanoe (que solo corre en Linux): para armar el mapa con mods en la PC
+// de quien juega. Mismo resultado que el taller en lo que la app usa: una
+// capa con el nombre del juego, zoom 4 a 13, los mismos atributos (-y) y el
+// mismo filtro por zoom (tiles_light_filter.json), tiles comprimidos con gzip.
+//
+// Uso: npx tsx packages/clis/truckdash-builder/tiles.ts <entrada.geojson> <capa> <salida.pmtiles>
+
+import fs from 'fs';
+import geojsonvt from 'geojson-vt';
+import { zxyToTileId } from 'pmtiles';
+import vtpbf from 'vt-pbf';
+import zlib from 'zlib';
+import { ATRIBUTOS, unirCalles, type Feature } from './unir-calles';
+
+const MIN_ZOOM = 4;
+const MAX_ZOOM = 13;
+const EXTENT = 4096;
+// tippecanoe -b 10: 10 pixeles de un tile de 256 -> 160 de 4096.
+const BUFFER = 160;
+
+// tiles_light_filter.json: hasta z6 solo ciudades, paises, ferries, trenes,
+// caminos (en z4 sin los locales) y los POI de ferry y tren.
+function visibleEn(zoom: number, p: Record<string, unknown>): boolean {
+  if (zoom >= 7) return true;
+  const type = p.type;
+  if (
+    type === 'city' ||
+    type === 'country' ||
+    type === 'ferry' ||
+    type === 'train'
+  )
+    return true;
+  if (type === 'road' && (zoom >= 5 || p.roadType !== 'local')) return true;
+  return p.poiType === 'ferry' || p.poiType === 'train';
+}
+
+function limpiar(f: Feature): Feature {
+  const props: Record<string, unknown> = {};
+  for (const k of ATRIBUTOS) {
+    const v = f.properties?.[k];
+    if (v !== undefined && v !== null) props[k] = v;
+  }
+  return { type: 'Feature', geometry: f.geometry, properties: props };
+}
+
+function lng2x(lng: number, z: number) {
+  return Math.floor(((lng + 180) / 360) * 2 ** z);
+}
+function lat2y(lat: number, z: number) {
+  const r = (lat * Math.PI) / 180;
+  return Math.floor(
+    ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * 2 ** z,
+  );
+}
+
+function bboxDe(features: Feature[]): [number, number, number, number] {
+  let w = 180,
+    s = 90,
+    e = -180,
+    n = -90;
+  const visitar = (c: unknown): void => {
+    if (Array.isArray(c) && typeof c[0] === 'number') {
+      const [x, y] = c as number[];
+      if (x < w) w = x;
+      if (x > e) e = x;
+      if (y < s) s = y;
+      if (y > n) n = y;
+    } else if (Array.isArray(c)) {
+      for (const x of c) visitar(x);
+    }
+  };
+  for (const f of features)
+    visitar((f.geometry as { coordinates?: unknown })?.coordinates);
+  return [w, s, e, n];
+}
+
+// ---------------------------------------------------------------- PMTiles v3
+function varint(n: number, out: number[]) {
+  while (n >= 0x80) {
+    out.push((n & 0x7f) | 0x80);
+    n = Math.floor(n / 128);
+  }
+  out.push(n);
+}
+
+interface Entrada {
+  tileId: number;
+  offset: number;
+  length: number;
+  runLength: number;
+}
+
+function serializarDirectorio(entradas: Entrada[]): Buffer {
+  const out: number[] = [];
+  varint(entradas.length, out);
+  let ultimo = 0;
+  for (const e of entradas) {
+    varint(e.tileId - ultimo, out);
+    ultimo = e.tileId;
+  }
+  for (const e of entradas) varint(e.runLength, out);
+  for (const e of entradas) varint(e.length, out);
+  entradas.forEach((e, i) => {
+    const prev = entradas[i - 1];
+    if (i > 0 && prev && e.offset === prev.offset + prev.length) varint(0, out);
+    else varint(e.offset + 1, out);
+  });
+  return zlib.gzipSync(Buffer.from(out));
+}
+
+// Raiz chica (entra en los primeros 16 KB) y hojas de a HOJA entradas.
+function directorios(entradas: Entrada[]): { raiz: Buffer; hojas: Buffer } {
+  const directa = serializarDirectorio(entradas);
+  if (directa.length + 127 <= 16384)
+    return { raiz: directa, hojas: Buffer.alloc(0) };
+  for (let hoja = 4096; ; hoja *= 2) {
+    const raices: Entrada[] = [];
+    const partes: Buffer[] = [];
+    let off = 0;
+    for (let i = 0; i < entradas.length; i += hoja) {
+      const b = serializarDirectorio(entradas.slice(i, i + hoja));
+      raices.push({
+        tileId: entradas[i].tileId,
+        offset: off,
+        length: b.length,
+        runLength: 0,
+      });
+      partes.push(b);
+      off += b.length;
+    }
+    const raiz = serializarDirectorio(raices);
+    if (raiz.length + 127 <= 16384)
+      return { raiz, hojas: Buffer.concat(partes) };
+  }
+}
+
+function escribirPmtiles(
+  salida: string,
+  tiles: { tileId: number; data: Buffer }[],
+  meta: object,
+  bbox: [number, number, number, number],
+  minZoom: number,
+  maxZoom: number,
+) {
+  tiles.sort((a, b) => a.tileId - b.tileId);
+  const entradas: Entrada[] = [];
+  let off = 0;
+  for (const t of tiles) {
+    entradas.push({
+      tileId: t.tileId,
+      offset: off,
+      length: t.data.length,
+      runLength: 1,
+    });
+    off += t.data.length;
+  }
+  const { raiz, hojas } = directorios(entradas);
+  const metadata = zlib.gzipSync(Buffer.from(JSON.stringify(meta)));
+  const h = Buffer.alloc(127);
+  h.write('PMTiles', 0, 'latin1');
+  h.writeUInt8(3, 7);
+  const rootOff = 127;
+  const metaOff = rootOff + raiz.length;
+  const leafOff = metaOff + metadata.length;
+  const dataOff = leafOff + hojas.length;
+  const u64 = (pos: number, v: number) => h.writeBigUInt64LE(BigInt(v), pos);
+  u64(8, rootOff);
+  u64(16, raiz.length);
+  u64(24, metaOff);
+  u64(32, metadata.length);
+  u64(40, leafOff);
+  u64(48, hojas.length);
+  u64(56, dataOff);
+  u64(64, off);
+  u64(72, tiles.length);
+  u64(80, entradas.length);
+  u64(88, tiles.length);
+  h.writeUInt8(1, 96); // clustered: los datos van en el orden de los tileId
+  h.writeUInt8(2, 97); // directorios en gzip
+  h.writeUInt8(2, 98); // tiles en gzip
+  h.writeUInt8(1, 99); // mvt
+  h.writeUInt8(minZoom, 100);
+  h.writeUInt8(maxZoom, 101);
+  const e7 = (v: number) => Math.round(v * 1e7);
+  h.writeInt32LE(e7(bbox[0]), 102);
+  h.writeInt32LE(e7(bbox[1]), 106);
+  h.writeInt32LE(e7(bbox[2]), 110);
+  h.writeInt32LE(e7(bbox[3]), 114);
+  h.writeUInt8(minZoom, 118);
+  h.writeInt32LE(e7((bbox[0] + bbox[2]) / 2), 119);
+  h.writeInt32LE(e7((bbox[1] + bbox[3]) / 2), 123);
+  const fd = fs.openSync(salida, 'w');
+  for (const b of [h, raiz, metadata, hojas]) fs.writeSync(fd, b);
+  for (const t of tiles) fs.writeSync(fd, t.data);
+  fs.closeSync(fd);
+}
+
+// -------------------------------------------------------------------- main
+function main() {
+  const [entrada, capa, salida] = process.argv.slice(2);
+  if (!entrada || !capa || !salida) {
+    console.error('Uso: tiles.ts <entrada.geojson> <capa> <salida.pmtiles>');
+    process.exit(1);
+  }
+  const t0 = Date.now();
+  const { features: todo, uniones } = unirCalles(
+    (
+      JSON.parse(fs.readFileSync(entrada, 'utf8')) as { features: Feature[] }
+    ).features.map(limpiar),
+    ATRIBUTOS,
+  );
+  const bbox = bboxDe(todo);
+  console.log(
+    `${todo.length} features (${uniones} calles unidas), bbox ${bbox.map(v => v.toFixed(3)).join(', ')}`,
+  );
+  const opciones = {
+    maxZoom: MAX_ZOOM,
+    indexMaxZoom: 5,
+    indexMaxPoints: 100000,
+    tolerance: 3,
+    extent: EXTENT,
+    buffer: BUFFER,
+  };
+  const fc = (fs2: Feature[]) => ({ type: 'FeatureCollection', features: fs2 });
+  // Un indice por tramo del filtro: z4, z5-6 y z7 en adelante.
+  const indices = [
+    {
+      desde: 4,
+      hasta: 4,
+      index: geojsonvt(
+        fc(todo.filter(f => visibleEn(4, f.properties!))),
+        opciones,
+      ),
+    },
+    {
+      desde: 5,
+      hasta: 6,
+      index: geojsonvt(
+        fc(todo.filter(f => visibleEn(5, f.properties!))),
+        opciones,
+      ),
+    },
+    { desde: 7, hasta: MAX_ZOOM, index: geojsonvt(fc(todo), opciones) },
+  ];
+  const tiles: { tileId: number; data: Buffer }[] = [];
+  const porZoom: Record<number, number> = {};
+  for (const { desde, hasta, index } of indices) {
+    // Al entrar a un indice se recorre toda la caja de ese zoom; despues se
+    // baja solo por los hijos de los tiles que tienen algo.
+    let actuales: [number, number][] = [];
+    const x0 = lng2x(bbox[0], desde),
+      x1 = lng2x(bbox[2], desde);
+    const y0 = lat2y(bbox[3], desde),
+      y1 = lat2y(bbox[1], desde);
+    for (let x = x0; x <= x1; x++)
+      for (let y = y0; y <= y1; y++) actuales.push([x, y]);
+    for (let z = desde; z <= hasta; z++) {
+      const conAlgo: [number, number][] = [];
+      for (const [x, y] of actuales) {
+        const tile = index.getTile(z, x, y);
+        if (!tile?.features.length) continue;
+        const pbf = vtpbf.fromGeojsonVt(
+          { [capa]: tile },
+          { version: 2, extent: EXTENT },
+        );
+        tiles.push({
+          tileId: zxyToTileId(z, x, y),
+          data: zlib.gzipSync(Buffer.from(pbf)),
+        });
+        conAlgo.push([x, y]);
+      }
+      porZoom[z] = conAlgo.length;
+      actuales = [];
+      for (const [x, y] of conAlgo) {
+        actuales.push(
+          [2 * x, 2 * y],
+          [2 * x + 1, 2 * y],
+          [2 * x, 2 * y + 1],
+          [2 * x + 1, 2 * y + 1],
+        );
+      }
+    }
+  }
+  const meta = {
+    name: capa,
+    format: 'pbf',
+    generator: 'truckdash-builder tiles.ts',
+    vector_layers: [
+      {
+        id: capa,
+        minzoom: MIN_ZOOM,
+        maxzoom: MAX_ZOOM,
+        fields: Object.fromEntries(ATRIBUTOS.map(a => [a, 'String'])),
+      },
+    ],
+  };
+  escribirPmtiles(salida, tiles, meta, bbox, MIN_ZOOM, MAX_ZOOM);
+  console.log(
+    `tiles por zoom ${JSON.stringify(porZoom)}; ${tiles.length} en total; ${((Date.now() - t0) / 1000).toFixed(1)} s`,
+  );
+}
+
+main();
