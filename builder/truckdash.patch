+    expect(entries.directories.get('map/usa')?.files).toEqual(['sec+0000+0000.base', 'sec+0001+0000.base']);
+    expect(entries.files.get('map/usa/sec+0000+0000.base')?.read()).toEqual(sector0);
+    expect(entries.files.get('map/usa/sec+0001+0000.base')?.read()).toEqual(sector1);
+    expect(avisos.join('\n')).toContain('3 entries read the way TruckLib reads them (metadata after its headers: 3)');
+  });
+
+  it('el tipo del metadato manda sobre la marca de directorio, y un metadato de mas no importa', () => {
+    const { entries, avisos } = leer([
